mut RuntimeTermios runtime_saved_terminal;
mut bool runtime_terminal_active = false;

cdef memcpy(*u8 destination, *u8 source, u64 count) -> *u8
{
    mut u64 runtime_index = 0;
    while (runtime_index < count)
    {
        destination[runtime_index] = source[runtime_index];
        runtime_index = runtime_index + 1;
    }
    return destination;
}

cdef memmove(*u8 destination, *u8 source, u64 count) -> *u8
{
    if (destination <= source)
    {
        return memcpy(destination, source, count);
    }
    mut u64 remaining = count;
    while (remaining > 0)
    {
        remaining = remaining - 1;
        destination[remaining] = source[remaining];
    }
    return destination;
}

cdef memset(*u8 destination, i32 value, u64 count) -> *u8
{
    mut u64 runtime_index = 0;
    while (runtime_index < count)
    {
        destination[runtime_index] = value as u8;
        runtime_index = runtime_index + 1;
    }
    return destination;
}

cdef memcmp(*u8 left, *u8 right, u64 count) -> i32
{
    mut u64 runtime_index = 0;
    while (runtime_index < count)
    {
        if (left[runtime_index] != right[runtime_index])
        {
            return left[runtime_index] - right[runtime_index];
        }
        runtime_index = runtime_index + 1;
    }
    return 0;
}

cdef __shaft_create_heap_chunk(u64 capacity) -> *HeapChunk
{
    mut u64 total_size = sizeof(HeapChunk) + capacity;
    mut u64 aligned_size = (total_size + 4095) & 0xFFFFFFFFFFFFF000;
    mut i64 mapping = __shaft_syscall6(runtime_sys_mmap, 0, aligned_size, 3, 4098, -1, 0);
    if (mapping <= 0 || mapping == -1)
    {
        return runtime_null;
    }
    mut *HeapChunk chunk = mapping as *HeapChunk;
    chunk.memory_pool = (mapping + sizeof(HeapChunk)) as *u8;
    chunk.length = 0;
    chunk.capacity = aligned_size - sizeof(HeapChunk);
    chunk.aligned_size = aligned_size;
    chunk.allocation_count = 0;
    chunk.next_address = 0;
    return chunk;
}

cdef __shaft_initialize_heap()
{
    if (!runtime_heap_initialized)
    {
        initial_chunk.memory_pool = &initial_runtime_memory_pool[0];
        initial_chunk.length = 0;
        initial_chunk.capacity = 1048576;
        initial_chunk.aligned_size = 0;
        initial_chunk.allocation_count = 0;
        initial_chunk.next_address = 0;
        runtime_heap_head = (&initial_chunk) as u64;
        runtime_heap_initialized = true;
    }
}

cdef __shaft_alloc(u64 count) -> *u8
{
    mut *u8 result = runtime_null;
    if (count <= 0xFFFFFFFFFFFFFFF8)
    {
        mut u64 aligned = (count + 7) & 0xFFFFFFFFFFFFFFF8;
        __shaft_runtime_lock();
        __shaft_initialize_heap();
        mut *HeapChunk current = runtime_heap_head as *HeapChunk;
        while (current != runtime_null)
        {
            mut u64 index = 0;
            while (index < current.allocation_count)
            {
                if (current.runtime_allocations[index].free && current.runtime_allocations[index].size >= aligned)
                {
                    mut u64 remaining = current.runtime_allocations[index].size - aligned;
                    if (remaining > 0 && current.allocation_count < 1024)
                    {
                        current.runtime_allocations[current.allocation_count].offset = current.runtime_allocations[index].offset + aligned;
                        current.runtime_allocations[current.allocation_count].size = remaining;
                        current.runtime_allocations[current.allocation_count].free = true;
                        current.allocation_count = current.allocation_count + 1;
                        current.runtime_allocations[index].size = aligned;
                    }
                    current.runtime_allocations[index].free = false;
                    result = &current.memory_pool[current.runtime_allocations[index].offset];
                    break;
                }
                index = index + 1;
            }
            if (result != runtime_null) { break; }
            if (current.allocation_count < 1024 && aligned <= current.capacity - current.length)
            {
                current.runtime_allocations[current.allocation_count].offset = current.length;
                current.runtime_allocations[current.allocation_count].size = aligned;
                current.runtime_allocations[current.allocation_count].free = false;
                current.length = current.length + aligned;
                current.allocation_count = current.allocation_count + 1;
                result = &current.memory_pool[current.runtime_allocations[current.allocation_count - 1].offset];
                break;
            }
            current = current.next_address as *HeapChunk;
        }
        if (result == runtime_null)
        {
            mut u64 capacity = 1048576;
            if (aligned > capacity) { capacity = aligned; }
            mut *HeapChunk chunk = __shaft_create_heap_chunk(capacity);
            if (chunk != runtime_null)
            {
                chunk.runtime_allocations[0].offset = 0;
                chunk.runtime_allocations[0].size = aligned;
                chunk.runtime_allocations[0].free = false;
                chunk.length = aligned;
                chunk.allocation_count = 1;
                chunk.next_address = runtime_heap_head;
                runtime_heap_head = chunk as u64;
                result = &chunk.memory_pool[0];
            }
        }
        __shaft_runtime_unlock();
    }
    return result;
}

cdef __shaft_free(*u8 pointer)
{
    if (pointer == runtime_null) { return; }
    __shaft_runtime_lock();
    __shaft_initialize_heap();
    mut *HeapChunk current = runtime_heap_head as *HeapChunk;
    mut *HeapChunk previous = runtime_null;
    mut bool found = false;
    while (current != runtime_null)
    {
        mut u64 freed_index = 0;
        mut u64 index = 0;
        while (index < current.allocation_count)
        {
            if (!current.runtime_allocations[index].free && pointer == &current.memory_pool[current.runtime_allocations[index].offset])
            {
                current.runtime_allocations[index].free = true;
                freed_index = index;
                found = true;
                break;
            }
            index = index + 1;
        }
        if (found)
        {
            mut bool merge_before = false;
            mut bool merge_after = false;
            mut u64 before_index = 0;
            mut u64 after_index = 0;
            mut u64 scan = 0;
            while (scan < current.allocation_count)
            {
                if (scan != freed_index && current.runtime_allocations[scan].free)
                {
                    if (current.runtime_allocations[scan].offset + current.runtime_allocations[scan].size == current.runtime_allocations[freed_index].offset)
                    {
                        merge_before = true;
                        before_index = scan;
                    }
                    else if (current.runtime_allocations[freed_index].offset + current.runtime_allocations[freed_index].size == current.runtime_allocations[scan].offset)
                    {
                        merge_after = true;
                        after_index = scan;
                    }
                }
                scan = scan + 1;
            }
            mut u64 new_offset = current.runtime_allocations[freed_index].offset;
            mut u64 new_size = current.runtime_allocations[freed_index].size;
            if (merge_before)
            {
                new_offset = current.runtime_allocations[before_index].offset;
                new_size = new_size + current.runtime_allocations[before_index].size;
            }
            if (merge_after) { new_size = new_size + current.runtime_allocations[after_index].size; }
            current.runtime_allocations[freed_index].offset = new_offset;
            current.runtime_allocations[freed_index].size = new_size;
            mut u64 remove_first = 0;
            mut u64 remove_second = 0;
            mut u64 removals = 0;
            if (merge_before) { remove_first = before_index; removals = removals + 1; }
            if (merge_after)
            {
                if (removals == 0) { remove_first = after_index; }
                else
                {
                    remove_second = after_index;
                    if (remove_first < remove_second)
                    {
                        mut u64 temporary = remove_first;
                        remove_first = remove_second;
                        remove_second = temporary;
                    }
                }
                removals = removals + 1;
            }
            if (removals >= 1)
            {
                current.runtime_allocations[remove_first] = current.runtime_allocations[current.allocation_count - 1];
                current.allocation_count = current.allocation_count - 1;
            }
            if (removals == 2)
            {
                current.runtime_allocations[remove_second] = current.runtime_allocations[current.allocation_count - 1];
                current.allocation_count = current.allocation_count - 1;
            }
            mut bool has_live_allocation = false;
            mut u64 live_index = 0;
            while (live_index < current.allocation_count)
            {
                if (!current.runtime_allocations[live_index].free)
                {
                    has_live_allocation = true;
                    break;
                }
                live_index = live_index + 1;
            }
            if (!has_live_allocation)
            {
                if (current == &initial_chunk)
                {
                    current.allocation_count = 0;
                    current.length = 0;
                }
                else
                {
                    if (previous == runtime_null) { runtime_heap_head = current.next_address; }
                    else { previous.next_address = current.next_address; }
                    __shaft_syscall6(runtime_sys_munmap, current, current.aligned_size, 0, 0, 0, 0);
                }
                break;
            }
            mut bool trimmed_tail = true;
            while (trimmed_tail)
            {
                trimmed_tail = false;
                mut u64 tail_index = 0;
                while (tail_index < current.allocation_count)
                {
                    if (current.runtime_allocations[tail_index].free &&
                    current.runtime_allocations[tail_index].offset + current.runtime_allocations[tail_index].size == current.length)
                    {
                        current.length = current.runtime_allocations[tail_index].offset;
                        current.runtime_allocations[tail_index] = current.runtime_allocations[current.allocation_count - 1];
                        current.allocation_count = current.allocation_count - 1;
                        trimmed_tail = true;
                        break;
                    }
                    tail_index = tail_index + 1;
                }
            }
            if (current != &initial_chunk)
            {
                mut u64 keep_size = (sizeof(HeapChunk) + current.length + 4095) & 0xFFFFFFFFFFFFF000;
                if (keep_size < current.aligned_size)
                {
                    __shaft_syscall6(runtime_sys_munmap, &((current as *u8)[keep_size]), current.aligned_size - keep_size, 0, 0, 0, 0);
                    current.aligned_size = keep_size;
                    current.capacity = keep_size - sizeof(HeapChunk);
                }
            }
            break;
        }
        previous = current;
        current = current.next_address as *HeapChunk;
    }
    __shaft_runtime_unlock();
}

cdef __sys_exit(i32 status)
{
    __sys_restore_terminal();
    __shaft_syscall6(runtime_sys_exit, status, 0, 0, 0, 0, 0);
    while (true) {}
}

cdef __shaft_alloc_or_exit(u64 count) -> *u8
{
    mut *u8 result = __shaft_alloc(count);
    if (result == runtime_null && count != 0)
    {
        __sys_exit(70);
    }
    return result;
}

cdef exit(i32 status)
{
    __sys_exit(status);
}

cdef __sys_write(i64 descriptor, *i8 buffer, u64 count) -> i64
{
    return __shaft_syscall6(runtime_sys_write, descriptor, buffer, count, 0, 0, 0);
}

cdef __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64
{
    return __shaft_syscall6(runtime_sys_read, descriptor, buffer, count, 0, 0, 0);
}

cdef __sys_execv(*i8 command, **i8 arguments) -> i64
{
    return __shaft_syscall6(runtime_sys_execv, command, arguments, runtime_null, 0, 0, 0);
}

cdef __sys_process_spawn(*i8 command, **i8 arguments, i64 stdout_descriptor, i64 stderr_descriptor) -> i64
{
    mut i64 pid = __shaft_syscall6(runtime_sys_fork, 0, 0, 0, 0, 0, 0);
    if (pid == 0)
    {
        if (stdout_descriptor >= 0)
        {
            __shaft_syscall6(runtime_sys_dup2, stdout_descriptor, 1, 0, 0, 0, 0);
            __shaft_syscall6(runtime_sys_close, stdout_descriptor, 0, 0, 0, 0, 0);
        }
        if (stderr_descriptor >= 0)
        {
            __shaft_syscall6(runtime_sys_dup2, stderr_descriptor, 2, 0, 0, 0, 0);
            __shaft_syscall6(runtime_sys_close, stderr_descriptor, 0, 0, 0, 0, 0);
        }
        __sys_execv(command, arguments);
        __sys_exit(127);
    }
    return pid;
}

cdef __sys_process_wait(i64 pid) -> i64
{
    mut i32 status = 0;
    mut i64 result = __shaft_syscall6(runtime_sys_wait4, pid, &status, 0, 0, 0, 0);
    if (result < 0)
    {
        return result;
    }
    return status;
}

cdef __sys_process_pipe(*i64 descriptors) -> i64
{
    mut i32[2] rawDescriptors;
    mut i64 result = __shaft_syscall6(runtime_sys_pipe, &rawDescriptors[0], 0, 0, 0, 0, 0);
    if (result == 0)
    {
        descriptors[0] = rawDescriptors[0];
        descriptors[1] = rawDescriptors[1];
    }
    return result;
}

cdef __sys_process_set_nonblocking(i64 descriptor) -> i64
{
    mut i64 flags = __shaft_syscall6(runtime_sys_fcntl, descriptor, 3, 0, 0, 0, 0);
    if (flags < 0)
    {
        return flags;
    }
    return __shaft_syscall6(runtime_sys_fcntl, descriptor, 4, flags | 4, 0, 0, 0);
}

