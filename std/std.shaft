cdec __shaft_alloc_or_exit(u64 count) -> *u8;
cdec __shaft_free(*u8 pointer);
cdec __sys_int_to_string(i64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_uint_to_string(u64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_float_to_string(f64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_exit(i32 status);

// Compiler-lowered native Thread support. These are runtime ABI hooks, not public APIs.
cdec __shaft_thread_clone(*u8 stack, *i32 tid) -> i64;
cdec __sys_thread_join(*i32 tid) -> i32;
cdec exit(i32 status);
cdec __sys_gettime_parts(*i64 seconds, *i64 nanoseconds) -> i32;
cdec __sys_sleep_ms(u64 milliseconds) -> i32;
cdec __sys_restore_terminal();
cdec __cstr_strlen(*i8 text) -> u64;
cdec __main(std::String[] args);

cdef __shaft_entry(i32 argc, **i8 argv) -> i32
{
    mut std::String[] args = __shaft_alloc_or_exit(argc * 24);
    mut u64 argumentIndex = 0;
    while (argumentIndex < argc)
    {
        *i8 text = argv[argumentIndex];
        u64 length = __cstr_strlen(text);
        args[argumentIndex].data = __shaft_alloc_or_exit(length + 1);
        args[argumentIndex].length = length;
        args[argumentIndex].capacity = length;
        memcpy(args[argumentIndex].data, text, length);
        argumentIndex = argumentIndex + 1;
    }
    __main(args);
    __sys_restore_terminal();
    return 0;
}

cdec __sys_open(*i8 pathname, i32 mode) -> i64;
cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;
cdec __sys_readline(*u8 buffer, u64 capacity) -> i64;
cdec __sys_close(i64 descriptor) -> i64;
cdec __sys_file_size(i64 descriptor) -> i64;

def readline() -> std::String result
{
    reserve mut std::String line = std::String::with_capacity(65536);
    reserve i64 length = __sys_readline(line.data, line.capacity);
    if (length < 0)
    {
        line.length = 0;
    }
    else
    {
        line.length = length;
    }
    line.data[line.length] = 0;
    tunnel line -> std::String result;
}

cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;

def read_bytes(u64 requested) -> std::String result
{
    mut *i8 buffer = __shaft_alloc_or_exit(requested);

    mut u64 total = 0;

    while (total < requested)
    {
        i64 n = __sys_read(
            0,
            buffer + total,
            requested - total
        );

        if (n <= 0)
        {
            break;
        }

        total = total + n;
    }

    mut std::str slice;
    slice.length = total;
    slice.data = buffer;
    slice.data[slice.length] = 0;
    reserve std::String s = std::String::from_str(slice);

    tunnel s -> std::String result;
}

namespace File
{
    def read_into(std::str pathname, *u8 buffer, u64 capacity) -> i64 result
    {
        mut i64 received = 0;
        reserve i64 descriptor = __sys_open(pathname.data, 0);
        if (descriptor >= 0)
        {
            while (received < capacity)
            {
                reserve i64 count = __sys_read(descriptor, &buffer[received], capacity - received);
                if (count <= 0)
                {
                    break;
                }
                received = received + count;
            }
            __sys_close(descriptor);
        }
        tunnel received -> i64 result;
    }

    def read(std::str pathname) -> std::String result
    {
        reserve mut std::String content;
        reserve i64 descriptor = __sys_open(pathname.data, 0);
        if (descriptor >= 0)
        {
            reserve i64 size = __sys_file_size(descriptor);
            if (size >= 0)
            {
                content = std::String::with_capacity(size);
                mut u64 received = 0;
                while (received < size)
                {
                    reserve i64 count = __sys_read(descriptor, &content.data[received], size - received);
                    if (count <= 0)
                    {
                        break;
                    }
                    received = received + count;
                }
                content.length = received;
                content.data[received] = 0;
            }
            __sys_close(descriptor);
        }
        tunnel content -> std::String result;
    }

    def write_at_mode(std::str pathname, std::str content, i32 openMode) -> i64 result
    {
        mut i64 total = 0;
        reserve i64 descriptor = __sys_open(pathname.data, openMode);
        if (descriptor >= 0)
        {
            while (total < content.length)
            {
                reserve i64 count = __sys_write(descriptor, &content.data[total], content.length - total);
                if (count <= 0)
                {
                    break;
                }
                total = total + count;
            }
            __sys_close(descriptor);
        }
        tunnel total -> i64 result;
    }

    def write(std::str pathname, std::str content) -> i64 result
    {
        tunnel std::File::write_at_mode(pathname, content, 1) -> i64 result;
    }

    def append(std::str pathname, std::str content) -> i64 result
    {
        tunnel std::File::write_at_mode(pathname, content, 3) -> i64 result;
    }
}

