    else if (mode == 1) { access = 1073741824; disposition = 2; }
    else if (mode == 2) { access = 3221225472; }
    else if (mode == 3) { access = 1073741824; disposition = 4; }
    else { return -1; }
    mut u64 file = CreateFileA(pathname, access, 3, runtime_null, disposition, 0, 0);
    if (file == 18446744073709551615) { return -1; }
    if (mode == 3 && SetFilePointerEx(file, 0, runtime_null_i64, 2) == 0)
    {
        CloseHandle(file);
        return -1;
    }
    return file;
}

cdef __sys_close(i64 descriptor) -> i64
{
    if (CloseHandle(descriptor) == 0) { return -1; }
