// Shaft std
@using global cstr! -> *u8;
cdec __shaft_free(*u8 pointer);

namespace std
{
    namespace string
    {

        struct String
        {
            mut *u8 data;
            mut u64 length;
            mut u64 capacity;
        }

    }

    namespace error
    {
        union<T> Result
        {
            Value(T),
            Error(std::string::String)
        }
    }

    namespace string
    {
        impl String
        {
            def len(&self) -> u64 result
            {
                tunnel self.length -> u64 result;
            }

            def is_empty(&self) -> bool result
            {
                tunnel self.length == 0 -> bool result;
            }

            def substr(&self, u64 offset, u64 requested) -> std::string::String result
            {
                reserve mut std::string::String substring;
                if (offset < self.length)
                {
                    mut u64 end = offset + requested;
                    if (end > self.length)
                    {
                        end = self.length;
                    }
                    substring.data = __shaft_alloc_or_exit(end - offset + 1);
                    substring.capacity = end - offset;
                    substring.length = end - offset;
                    mut u64 i = 0;
                    while (i < substring.length)
                    {
                        substring.data[i] = self.data[offset + i];
                        i = i + 1;
                    }
                    substring.data[substring.length] = 0;
                }
                else
                {
                    substring.data = __shaft_alloc_or_exit(1);
                    substring.capacity = 0;
                    substring.length = 0;
                    substring.data[0] = 0;
                }
                tunnel substring -> std::string::String result;
            }

            def get_view(&self) -> std::string::view::View result
            {
                reserve mut std::string::view::View view;
                view.data = self.data;
                view.length = self.length;
                tunnel view -> std::string::view::View result;
            }
            def find(&self, std::string::view::View needle) -> bool contains, ?-> u64 position
            {
                mut bool found = false;
                mut u64 foundPosition = 0;
                if (needle.length == 0)
                {
                    found = true;
                }
                else
                {
                    if (needle.length <= self.length)
                    {
                        mut u64 first = 0;
                        while (first + needle.length <= self.length)
                        {
                            mut u64 offset = 0;
                            mut bool matches = true;
                            while (offset < needle.length)
                            {
                                if (self.data[first + offset] != needle.data[offset])
                                {
                                    matches = false;
                                    break;
                                }
                                offset = offset + 1;
                            }
                            if (matches)
                            {
                                found = true;
                                foundPosition = first;
                                break;
                            }
                            first = first + 1;
                        }
                    }
                }
                tunnel found -> bool contains;
                if (found)
                {
                    tunnel foundPosition -> u64 position;
                }
            }
            def compare(&self, std::string::view::View other) -> i32 result
            {
                mut i32 comparison = 0;
                mut u64 offset = 0;
                mut u64 sharedLength = self.length;
                if (other.length < sharedLength)
                {
                    sharedLength = other.length;
                }
                while (offset < sharedLength)
                {
                    if (self.data[offset] < other.data[offset])
                    {
                        comparison = -1;
                        break;
                    }
                    if (self.data[offset] > other.data[offset])
                    {
                        comparison = 1;
                        break;
                    }
                    offset = offset + 1;
                }
                if (comparison == 0)
                {
                    if (self.length < other.length)
                    {
                        comparison = -1;
                    }
                    if (self.length > other.length)
                    {
                        comparison = 1;
                    }
                }
                tunnel comparison -> i32 result;
            }
            def equals(&self, std::string::view::View other) -> bool result
            {
                mut bool equal = self.length == other.length;
                mut u64 offset = 0;
                while (equal && offset < self.length)
                {
                    if (self.data[offset] != other.data[offset])
                    {
                        equal = false;
                        break;
                    }
                    offset = offset + 1;
                }
                tunnel equal -> bool result;
            }
            def hash(&self) -> u64 result
            {
                mut u64 value = 14695981039346656037;
                mut u64 offset = 0;
                while (offset < self.length)
                {
                    value = value ^ self.data[offset];
                    value = value * 1099511628211;
                    offset = offset + 1;
                }
                tunnel value -> u64 result;
            }
            def to_int(&self, i64 begin, i64 end) -> std::error::Result<i64> integer
            {
                mut bool isValid = begin < end;
                mut i64 cursor = begin;
                mut i8 sign = 1;
                mut i64 result = 0;
                mut std::error::Result<i64> res;

                if (isValid && self.data[cursor] == '-')
                {
                    sign = -1;
                    cursor += 1;
                }
                else if (isValid && self.data[cursor] == '+')
                {
                    cursor += 1;
                }

                for (mut usize i = cursor as usize; isValid && i < end as usize; i += 1)
                {
                    char character = self.data[i];
                    if (character < '0' || character > '9')
                    {
                        isValid = false;
                    }
                    else
                    {
                        u8 digit = (character - '0') as u8;
                        result = result * (10 as i64) + (digit as i64);
                    }
                }
                if (isValid)
                {
                    mut std::error::Result<i64> parsed = std::error::Result::Value(result * (sign as i64));
                    res = move parsed;
                }
                else
                {
                    mut std::error::Result<i64> parsed = std::error::Result::Error(self.substr(0, 0));
                    res = move parsed;
                }
                tunnel res -> std::error::Result<i64> integer;
            }
            def reverse(&self) -> std::string::String result
            {
                reserve mut std::string::String reversed;
                reversed.data = __shaft_alloc_or_exit(self.length + 1);
                reversed.length = 0;
                reversed.capacity = self.length;
                mut u64 offset = 0;
                while (offset < self.length)
                {
                    reversed.data[offset] = self.data[self.length - offset - 1];
                    offset = offset + 1;
                }
                reversed.length = self.length;
                reversed.data[reversed.length] = 0;
                tunnel reversed -> std::string::String result;
            }
            def capacity(&self) -> u64 result
            {
                tunnel self.capacity -> u64 result;
            }
            def parse_u64(&self) -> bool parsed, ?-> u64 value
            {
                mut bool success = self.length > 0;
                mut u64 offset = 0;
                mut u64 resultValue = 0;
                while (success && offset < self.length)
                {
                    mut u8 byte = self.data[offset];
                    if (byte < 48 || byte > 57)
                    {
                        success = false;
                    }
                    else
                    {
                        mut u64 digit = byte - 48;
                        if (resultValue > 1844674407370955161 ||
                        (resultValue == 1844674407370955161 && digit > 5))
                        {
                            success = false;
                        }
                        else
                        {
                            resultValue = resultValue * 10 + digit;
                        }
                    }
                    offset = offset + 1;
                }
                tunnel success -> bool parsed;
                if (success)
                {
                    tunnel resultValue -> u64 value;
                }
            }

            def parse_i64(&self) -> bool parsed, ?-> i64 value
            {
                mut u64 offset = 0;
                mut bool negative = false;
                if (self.length > 0 && self.data[0] == 45)
                {
                    negative = true;
                    offset = 1;
                }

                mut bool success = offset < self.length;
                mut u64 magnitude = 0;
                mut u64 limit = 9223372036854775807;
                if (negative)
                {
                    limit = 9223372036854775808;
                }
                while (success && offset < self.length)
                {
                    mut u8 byte = self.data[offset];
                    if (byte < 48 || byte > 57)
                    {
                        success = false;
                    }
                    else
                    {
                        mut u64 digit = byte - 48;
                        if (magnitude > limit / 10 || (magnitude == limit / 10 && digit > limit % 10))
                        {
                            success = false;
                        }
                        else
                        {
                            magnitude = magnitude * 10 + digit;
                        }
                    }
                    offset = offset + 1;
                }
                tunnel success -> bool parsed;
                if (success)
                {
                    if (negative)
                    {
                        tunnel (0 as i64) - (magnitude as i64) -> i64 value;
                    }
                    else
                    {
                        tunnel magnitude as i64 -> i64 value;
                    }
                }
            }

            def parse_f64(&self) -> bool parsed, ?-> f64 value
            {
                mut u64 offset = 0;
                mut bool negative = false;
                if (self.length > 0 && self.data[0] == 45)
                {
                    negative = true;
                    offset = 1;
                }
                mut bool success = offset < self.length;
                mut bool decimal = false;
                mut bool digits = false;
                mut bool fractionDigits = false;
                mut f64 resultValue = 0.0;
                mut f64 divisor = 1.0;
                while (success && offset < self.length)
                {
                    mut u8 byte = self.data[offset];
                    if (byte == 46)
                    {
                        if (decimal || !digits)
                        {
                            success = false;
                        }
                        else
                        {
                            decimal = true;
                        }
                    }
                    else
                    {
                        if (byte < 48 || byte > 57)
                        {
                            success = false;
                        }
                        else
                        {
                            mut f64 digit = (byte as f64) - 48.0;
                            digits = true;
                            if (decimal)
                            {
                                fractionDigits = true;
                                divisor = divisor * 10.0;
                                resultValue = resultValue + digit / divisor;
                            }
                            else
                            {
                                resultValue = resultValue * 10.0 + digit;
                            }
                        }
                    }
                    offset = offset + 1;
                }
                if (decimal && !fractionDigits)
                {
                    success = false;
                }
                tunnel success -> bool parsed;
                if (success)
                {
                    if (negative)
                    {
                        tunnel 0.0 - resultValue -> f64 value;
                    }
                    else
                    {
                        tunnel resultValue -> f64 value;
                    }
                }
            }

            def append(*std::string::String string, std::string::view::View value) -> bool result
            {
                mut bool was_resized = false;
                mut u64 new_capacity = string.capacity;
                while (new_capacity < string.length + value.length + 1)
                {
                    was_resized = true;
                    if (new_capacity == 0)
                    {
                        new_capacity = 8;
                    }
                    else
                    {
                        new_capacity *= 2;
                    }
                }
                if (was_resized == true)
                {
                    mut *u8 newData = __shaft_alloc_or_exit(new_capacity);

                    for (mut u64 i = 0; i <= string.length; i += 1)
                    {
                        newData[i] = string.data[i];
                    }
                    string.data = move newData;
                    string.capacity = new_capacity;
                }
                for (mut i32 i = 0; i < value.length; i += 1)
                {
                    string.data[string.length + i] = value.data[i];
                }
                string.length = string.length + value.length;
                string.data[string.length] = 0;
                tunnel true -> bool result;
            }

            def set(*std::string::String string, std::string::view::View value) -> bool result
            {
                mut bool was_resized = false;
                mut u64 new_capacity = string.capacity;
                string.length = 0;
                string.data[0] = 0;
                while (new_capacity < string.length + value.length + 1)
                {
                    was_resized = true;
                    if (new_capacity == 0)
                    {
                        new_capacity = 8;
                    }
                    else
                    {
                        new_capacity *= 2;
                    }
                }
                if (was_resized == true)
                {
                    mut *u8 newData = __shaft_alloc_or_exit(new_capacity);

                    for (mut u64 i = 0; i <= string.length; i += 1)
                    {
                        newData[i] = string.data[i];
                    }
                    string.data = move newData;
                    string.capacity = new_capacity;
                }
                for (mut i32 i = 0; i < value.length; i += 1)
                {
                    string.data[string.length + i] = value.data[i];
                }
                string.length = string.length + value.length;
                string.data[string.length] = 0;
                tunnel true -> bool result;
            }

            def append_string(&mut self, &std::string::String other) -> bool result
            {
                std::string::view::View buffer = {other.length, other.data};
                self.append(buffer);
                tunnel true -> bool result;
            }

            def append_cstr(&mut self, cstr! value) -> bool result
            {
                mut u64 valueLength = 0;
                while (value[valueLength] != 0)
                {
                    valueLength = valueLength + 1;
                }
                mut std::string::view::View buffer;
                buffer.data = value;
                buffer.length = valueLength;
                self.append(buffer);
                tunnel true -> bool result;
            }

            def with_capacity(u64 requested) -> std::string::String result
            {
                reserve mut std::string::String value;
                value.data = __shaft_alloc(requested + 1);
                value.length = 0;
                value.capacity = requested;
                tunnel value -> std::string::String result;
            }

            def from_int(i64 value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.data = __shaft_alloc_or_exit(32);
                resultValue.capacity = 31;
                resultValue.length = __sys_int_to_string(
                value,
                resultValue.data,
                resultValue.capacity
                );
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_float(f64 value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.data = __shaft_alloc_or_exit(64);
                resultValue.capacity = 63;
                resultValue.length = __sys_float_to_string(
                value,
                resultValue.data,
                resultValue.capacity
                );
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_u64(u64 value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.data = __shaft_alloc_or_exit(32);
                resultValue.capacity = 31;
                resultValue.length = __sys_uint_to_string(value, resultValue.data, resultValue.capacity);
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_i8(i8 value) -> std::string::String result { tunnel std::string::String::from_int(value) -> std::string::String result; }

            def from_u8(u8 value) -> std::string::String result { tunnel std::string::String::from_u64(value) -> std::string::String result; }

            def from_i16(i16 value) -> std::string::String result { tunnel std::string::String::from_int(value) -> std::string::String result; }

            def from_u16(u16 value) -> std::string::String result { tunnel std::string::String::from_u64(value) -> std::string::String result; }

            def from_i32(i32 value) -> std::string::String result { tunnel std::string::String::from_int(value) -> std::string::String result; }

            def from_u32(u32 value) -> std::string::String result { tunnel std::string::String::from_u64(value) -> std::string::String result; }

            def from_i64(i64 value) -> std::string::String result { tunnel std::string::String::from_int(value) -> std::string::String result; }

            def from_usize(usize value) -> std::string::String result { tunnel std::string::String::from_u64(value) -> std::string::String result; }

            def from_f32(f32 value) -> std::string::String result { tunnel std::string::String::from_float(value) -> std::string::String result; }

            def from_f64(f64 value) -> std::string::String result { tunnel std::string::String::from_float(value) -> std::string::String result; }

            def from_bool(bool value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                if (value)
                {
                    resultValue.data = __shaft_alloc_or_exit(5); resultValue.capacity = 4; resultValue.length = 4;
                    resultValue.data[0] = 116; resultValue.data[1] = 114; resultValue.data[2] = 117; resultValue.data[3] = 101;
                }
                else
                {
                    resultValue.data = __shaft_alloc_or_exit(6); resultValue.capacity = 5; resultValue.length = 5;
                    resultValue.data[0] = 102; resultValue.data[1] = 97; resultValue.data[2] = 108; resultValue.data[3] = 115; resultValue.data[4] = 101;
                }
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_char(char value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.data = __shaft_alloc_or_exit(2); resultValue.capacity = 1; resultValue.length = 1;
                resultValue.data[0] = value as u8; resultValue.data[1] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_view(std::string::view::View value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.data = __shaft_alloc_or_exit(value.length + 1);
                resultValue.capacity = value.length + 1;
                std::memory::memcpy(resultValue.data, value.data, value.length);
                resultValue.length = value.length;
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }

            def from_str(cstr! value) -> std::string::String result
            {
                reserve mut std::string::String resultValue;
                resultValue.length = __cstr_strlen(value);
                resultValue.capacity = resultValue.length + 1;
                resultValue.data = __shaft_alloc_or_exit(resultValue.capacity);
                std::memory::memcpy(resultValue.data, value, resultValue.length);
                resultValue.data[resultValue.length] = 0;
                tunnel resultValue -> std::string::String result;
            }
        } // impl String
    } // namespace string

    namespace string
    {
        namespace view
        {
            struct View
            {
                mut *u8 data;
                mut u64 length;
            }

            impl View
            {
                def is_empty(&self) -> bool result
                {
                    tunnel self.length == 0 -> bool result;
                }

                def find(&self, std::string::view::View needle) -> bool contains, ?-> u64 position
                {
                    mut bool found = false;
                    mut u64 foundPosition = 0;
                    if (needle.length == 0)
                    {
                        found = true;
                    }
                    else
                    {
                        if (needle.length <= self.length)
                        {
                            mut u64 first = 0;
                            while (first + needle.length <= self.length)
                            {
                                mut u64 offset = 0;
                                mut bool matches = true;
                                while (offset < needle.length)
                                {
                                    if (self.data[first + offset] != needle.data[offset])
                                    {
                                        matches = false;
                                        break;
                                    }
                                    offset = offset + 1;
                                }
                                if (matches)
                                {
                                    found = true;
                                    foundPosition = first;
                                    break;
                                }
                                first = first + 1;
                            }
                        }
                    }
                    tunnel found -> bool contains;
                    if (found)
                    {
                        tunnel foundPosition -> u64 position;
                    }
                }

                def substr(&self, u64 offset, u64 requested) -> std::string::view::View result
                {
                    reserve mut std::string::view::View substring;
                    if (offset < self.length)
                    {
                        mut u64 end = offset + requested;
                        if (end > self.length)
                        {
                            end = self.length;
                        }
                        substring.data = __shaft_alloc_or_exit(end - offset + 1);
                        substring.length = end - offset;
                        mut u64 i = 0;
                        while (i < substring.length)
                        {
                            substring.data[i] = self.data[offset + i];
                            i = i + 1;
                        }
                        substring.data[substring.length] = 0;
                    }
                    else
                    {
                        substring.data = __shaft_alloc_or_exit(1);
                        substring.length = 0;
                        substring.data[0] = 0;
                    }
                    tunnel substring -> std::string::view::View result;
                }

                def from_str(cstr! value) -> std::string::view::View result
                {
                    reserve mut std::string::view::View resultValue;
                    resultValue.length = __cstr_strlen(value);
                    resultValue.data = value;
                    tunnel resultValue -> std::string::view::View result;
                }
            }
        }
    }
    namespace string
    {
        namespace format
        {
            // Format one view into every `{}` placeholder. `{{` and `}}`
            // write literal braces; unmatched braces report formatted = false.
            def one(std::string::view::View template, std::string::view::View value) -> bool formatted, ?-> std::string::String result
            {
                mut bool is_valid = true;
                mut u64 output_length = 0;
                mut u64 index = 0;
                while (is_valid && index < template.length)
                {
                    mut u8 byte = template.data[index];
                    if (byte == 123)
                    {
                        if (index + 1 >= template.length)
                        {
                            is_valid = false;
                        }
                        else if (template.data[index + 1] == 123)
                        {
                            output_length = output_length + 1;
                            index = index + 2;
                        }
                        else if (template.data[index + 1] == 125)
                        {
                            output_length = output_length + value.length;
                            index = index + 2;
                        }
                        else
                        {
                            is_valid = false;
                        }
                    }
                    else if (byte == 125)
                    {
                        if (index + 1 < template.length && template.data[index + 1] == 125)
                        {
                            output_length = output_length + 1;
                            index = index + 2;
                        }
                        else
                        {
                            is_valid = false;
                        }
                    }
                    else
                    {
                        output_length = output_length + 1;
                        index = index + 1;
                    }
                }

                tunnel is_valid -> bool formatted;
                if (is_valid)
                {
                    reserve mut std::string::String output;
                    output.data = __shaft_alloc_or_exit(output_length + 1);
                    output.capacity = output_length;
                    output.length = 0;
                    index = 0;
                    while (index < template.length)
                    {
                        mut u8 byte = template.data[index];
                        if (byte == 123 && template.data[index + 1] == 125)
                        {
                            mut u64 value_index = 0;
                            while (value_index < value.length)
                            {
                                output.data[output.length] = value.data[value_index];
                                output.length = output.length + 1;
                                value_index = value_index + 1;
                            }
                            index = index + 2;
                        }
                        else if ((byte == 123 || byte == 125) && template.data[index + 1] == byte)
                        {
                            output.data[output.length] = byte;
                            output.length = output.length + 1;
                            index = index + 2;
                        }
                        else
                        {
                            output.data[output.length] = byte;
                            output.length = output.length + 1;
                            index = index + 1;
                        }
                    }
                    output.data[output.length] = 0;
                    tunnel output -> std::string::String result;
                }
            }

            // Format exactly two `{}` placeholders in source order. Literal
            // braces use the same `{{`/`}}` spelling as one(...).
            def two(std::string::view::View template, std::string::view::View first, std::string::view::View second) -> bool formatted, ?-> std::string::String result
            {
                mut bool is_valid = true;
                mut u64 placeholders = 0;
                mut u64 output_length = 0;
                mut u64 index = 0;
                while (is_valid && index < template.length)
                {
                    mut u8 byte = template.data[index];
                    if (byte == 123 && index + 1 < template.length && template.data[index + 1] == 125)
                    {
                        if (placeholders == 0) { output_length = output_length + first.length; }
                        else if (placeholders == 1) { output_length = output_length + second.length; }
                        else { is_valid = false; }
                        placeholders = placeholders + 1;
                        index = index + 2;
                    }
                    else if ((byte == 123 || byte == 125) && index + 1 < template.length && template.data[index + 1] == byte)
                    {
                        output_length = output_length + 1;
                        index = index + 2;
                    }
                    else if (byte == 123 || byte == 125)
                    {
                        is_valid = false;
                    }
                    else
                    {
                        output_length = output_length + 1;
                        index = index + 1;
                    }
                }
                if (placeholders != 2) { is_valid = false; }
                tunnel is_valid -> bool formatted;
                if (is_valid)
                {
                    reserve mut std::string::String output;
                    output.data = __shaft_alloc_or_exit(output_length + 1);
                    output.capacity = output_length;
                    output.length = 0;
                    index = 0;
                    placeholders = 0;
                    while (index < template.length)
                    {
                        mut u8 byte = template.data[index];
                        if (byte == 123 && template.data[index + 1] == 125)
                        {
                            mut std::string::view::View value = first;
                            if (placeholders == 1) { value = second; }
                            mut u64 value_index = 0;
                            while (value_index < value.length)
                            {
                                output.data[output.length] = value.data[value_index];
                                output.length = output.length + 1;
                                value_index = value_index + 1;
                            }
                            placeholders = placeholders + 1;
                            index = index + 2;
                        }
                        else if ((byte == 123 || byte == 125) && template.data[index + 1] == byte)
                        {
                            output.data[output.length] = byte;
                            output.length = output.length + 1;
                            index = index + 2;
                        }
                        else
                        {
                            output.data[output.length] = byte;
                            output.length = output.length + 1;
                            index = index + 1;
                        }
                    }
                    output.data[output.length] = 0;
                    tunnel output -> std::string::String result;
                }
            }

            def many(std::string::view::View template, *std::string::view::View values, u64 value_count) -> bool formatted, ?-> std::string::String result
            {
                mut bool is_valid = true;
                mut u64 placeholder = 0;
                mut u64 output_length = 0;
                mut u64 index = 0;
                while (is_valid && index < template.length)
                {
                    mut u8 byte = template.data[index];
                    if (byte == 123 && index + 1 < template.length && template.data[index + 1] == 125)
                    {
                        if (placeholder >= value_count)
                        {
                            is_valid = false;
                        }
                        else
                        {
                            output_length = output_length + values[placeholder].length;
                            placeholder = placeholder + 1;
                        }
                        index = index + 2;
                    }
                    else if ((byte == 123 || byte == 125) && index + 1 < template.length && template.data[index + 1] == byte)
                    {
                        output_length = output_length + 1;
                        index = index + 2;
                    }
                    else if (byte == 123 || byte == 125)
                    {
                        is_valid = false;
                    }
                    else
                    {
                        output_length = output_length + 1;
                        index = index + 1;
                    }
                }
                if (placeholder != value_count) { is_valid = false; }
                tunnel is_valid -> bool formatted;
                if (is_valid)
                {
                    reserve mut std::string::String output;
                    output.data = __shaft_alloc_or_exit(output_length + 1);
                    output.capacity = output_length;
                    output.length = output_length;
                    index = 0;
                    placeholder = 0;
                    mut u64 output_index = 0;
                    while (index < template.length)
                    {
                        mut u8 byte = template.data[index];
                        if (byte == 123 && template.data[index + 1] == 125)
                        {
                            mut std::string::view::View value = values[placeholder];
                            mut u64 value_index = 0;
                            while (value_index < value.length)
                            {
                                output.data[output_index] = value.data[value_index];
                                output_index = output_index + 1;
                                value_index = value_index + 1;
                            }
                            placeholder = placeholder + 1;
                            index = index + 2;
                        }
                        else if ((byte == 123 || byte == 125) && template.data[index + 1] == byte)
                        {
                            output.data[output_index] = byte;
                            output_index = output_index + 1;
                            index = index + 2;
                        }
                        else
                        {
                            output.data[output_index] = byte;
                            output_index = output_index + 1;
                            index = index + 1;
                        }
                    }
                    output.data[output.length] = 0;
                    tunnel output -> std::string::String result;
                }
            }

            // Single-optional-result wrapper for source macros. It keeps the
            // multi-tunnel binding names local to this ordinary std function.
            def render_many(std::string::view::View template, *std::string::view::View values, u64 value_count) ?-> std::string::String result
            {
                reserve bool formatted;
                reserve ?std::string::String result;
                std::string::format::many(template, values, value_count);
                valid result
                {
                    tunnel result -> std::string::String result;
                }
            }

            namespace regex
            {
                // A deliberately small, allocation-free full-string matcher.
                // Supported atoms are literal bytes, `.` and a postfix `*`.
                def matches_from(std::string::view::View text, std::string::view::View pattern,
                u64 text_index, u64 pattern_index) -> bool result
                {
                    mut bool matches = false;
                    if (pattern_index == pattern.length)
                    {
                        matches = text_index == text.length;
                    }
                    else
                    {
                        mut u8 atom = pattern.data[pattern_index];
                        mut bool has_star = pattern_index + 1 < pattern.length && pattern.data[pattern_index + 1] == 42;
                        if (has_star)
                        {
                            mut u64 cursor = text_index;
                            while (cursor < text.length && (atom == 46 || atom == text.data[cursor]))
                            {
                                cursor = cursor + 1;
                            }
                            while (true)
                            {
                                matches = std::string::format::regex::matches_from(text, pattern, cursor, pattern_index + 2);
                                if (matches || cursor == text_index)
                                {
                                    break;
                                }
                                cursor = cursor - 1;
                            }
                        }
                        else
                        {
                            if (text_index < text.length && (atom == 46 || atom == text.data[text_index]))
                            {
                                matches = std::string::format::regex::matches_from(text, pattern, text_index + 1, pattern_index + 1);
                            }
                        }
                    }
                    tunnel matches -> bool result;
                }

                def is_match(std::string::view::View text, std::string::view::View pattern) -> bool result
                {
                    tunnel std::string::format::regex::matches_from(text, pattern, 0, 0) -> bool result;
                }
            }
        }
    }

    namespace json
    {
        // Literal values reach this API after Shaft has decoded their source
        // escapes, so no second escape pass is performed here. File-backed
        // JSON token serialization remains available through quote(...).
        def from_literal(std::string::view::View text) -> std::string::String result
        {
            tunnel std::string::String::from_view(text) -> std::string::String result;
        }

        def hex_value(u8 digit) -> u8 result
        {
            mut u8 value = (digit - 48) as u8;
            if (digit >= 97) { value = (digit - 97 + 10) as u8; }
            else if (digit >= 65) { value = (digit - 65 + 10) as u8; }
            tunnel value -> u8 result;
        }

        // Decode a JSON string token read from a file. Literal construction
        // uses from_literal(...) instead, because the Shaft lexer has already
        // decoded its source escapes. `\\u` decoding is limited to the
        // byte-preserving `\\u00XX` form emitted by quote(...).
        def unquote(std::string::view::View encoded) -> bool decoded, ?-> std::string::String result
        {
            mut bool is_valid = encoded.length >= 2 && encoded.data[0] == 34 && encoded.data[encoded.length - 1] == 34;
            mut u64 output_length = 0;
            mut u64 index = 1;
            while (is_valid && index + 1 < encoded.length)
            {
                mut u8 byte = encoded.data[index];
                if (byte != 92)
                {
                    if (byte < 32) { is_valid = false; }
                    else { output_length = output_length + 1; index = index + 1; }
                }
                else if (index + 2 >= encoded.length)
                {
                    is_valid = false;
                }
                else
                {
                    mut u8 escaped = encoded.data[index + 1];
                    if (escaped == 34 || escaped == 92 || escaped == 47 || escaped == 98 || escaped == 102 || escaped == 110 || escaped == 114 || escaped == 116)
                    {
                        output_length = output_length + 1;
                        index = index + 2;
                    }
                    else if (escaped == 117)
                    {
                        if (index + 5 >= encoded.length - 1 || encoded.data[index + 2] != 48 || encoded.data[index + 3] != 48)
                        {
                            is_valid = false;
                        }
                        else
                        {
                            mut u8 high = encoded.data[index + 4];
                            mut u8 low = encoded.data[index + 5];
                            if (!((high >= 48 && high <= 57) || (high >= 65 && high <= 70) || (high >= 97 && high <= 102)) ||
                            !((low >= 48 && low <= 57) || (low >= 65 && low <= 70) || (low >= 97 && low <= 102)))
                            {
                                is_valid = false;
                            }
                            else
                            {
                                output_length = output_length + 1;
                                index = index + 6;
                            }
                        }
                    }
                    else
                    {
                        is_valid = false;
                    }
                }
            }

            tunnel is_valid -> bool decoded;
            if (is_valid)
            {
                reserve mut std::string::String output;
                output.data = __shaft_alloc_or_exit(output_length + 1);
                output.capacity = output_length;
                output.length = 0;
                index = 1;
                while (index + 1 < encoded.length)
                {
                    mut u8 byte = encoded.data[index];
                    if (byte != 92)
                    {
                        output.data[output.length] = byte;
                        output.length = output.length + 1;
                        index = index + 1;
                    }
                    else
                    {
                        mut u8 escaped = encoded.data[index + 1];
                        mut u8 value = escaped;
                        if (escaped == 98) { value = 8; }
                        else if (escaped == 102) { value = 12; }
                        else if (escaped == 110) { value = 10; }
                        else if (escaped == 114) { value = 13; }
                        else if (escaped == 116) { value = 9; }
                        else if (escaped == 117)
                        {
                            mut u8 high = encoded.data[index + 4];
                            mut u8 low = encoded.data[index + 5];
                            reserve u8 high_value = std::json::hex_value(high);
                            reserve u8 low_value = std::json::hex_value(low);
                            value = (high_value * 16 + low_value) as u8;
                            index = index + 4;
                        }
                        output.data[output.length] = value;
                        output.length = output.length + 1;
                        index = index + 2;
                    }
                }
                output.data[output.length] = 0;
                tunnel output -> std::string::String result;
            }
        }

        // JSON string-token encoder for values that are read at runtime, such
        // as file input. UTF-8 bytes are copied unchanged while control bytes
        // and JSON delimiters are escaped.
        def quote(std::string::view::View text) -> std::string::String result
        {
            mut u64 output_length = 2;
            mut u64 index = 0;
            while (index < text.length)
            {
                mut u8 byte = text.data[index];
                if (byte == 34 || byte == 92 || byte == 8 || byte == 9 || byte == 10 || byte == 12 || byte == 13)
                {
                    output_length = output_length + 2;
                }
                else if (byte < 32)
                {
                    output_length = output_length + 6;
                }
                else
                {
                    output_length = output_length + 1;
                }
                index = index + 1;
            }

            reserve mut std::string::String output;
            output.data = __shaft_alloc_or_exit(output_length + 1);
            output.capacity = output_length;
            output.length = 0;
            output.data[output.length] = 34;
            output.length = output.length + 1;
            index = 0;
            while (index < text.length)
            {
                mut u8 byte = text.data[index];
                if (byte == 34 || byte == 92)
                {
                    output.data[output.length] = 92;
                    output.length = output.length + 1;
                    output.data[output.length] = byte;
                    output.length = output.length + 1;
                }
                else if (byte == 8 || byte == 9 || byte == 10 || byte == 12 || byte == 13)
                {
                    mut u8 escaped = 98;
                    if (byte == 9) { escaped = 116; }
                    else if (byte == 10) { escaped = 110; }
                    else if (byte == 12) { escaped = 102; }
                    else if (byte == 13) { escaped = 114; }
                    output.data[output.length] = 92;
                    output.length = output.length + 1;
                    output.data[output.length] = escaped;
                    output.length = output.length + 1;
                }
                else if (byte < 32)
                {
                    mut u8 high = (byte / 16) as u8;
                    mut u8 low = (byte % 16) as u8;
                    output.data[output.length] = 92;
                    output.length = output.length + 1;
                    output.data[output.length] = 117;
                    output.length = output.length + 1;
                    output.data[output.length] = 48;
                    output.length = output.length + 1;
                    output.data[output.length] = 48;
                    output.length = output.length + 1;
                    mut u8 high_char = (high + 48) as u8;
                    mut u8 low_char = (low + 48) as u8;
                    if (high >= 10) { high_char = (high - 10 + 97) as u8; }
                    if (low >= 10) { low_char = (low - 10 + 97) as u8; }
                    output.data[output.length] = high_char;
                    output.length = output.length + 1;
                    output.data[output.length] = low_char;
                    output.length = output.length + 1;
                }
                else
                {
                    output.data[output.length] = byte;
                    output.length = output.length + 1;
                }
                index = index + 1;
            }
            output.data[output.length] = 34;
            output.length = output.length + 1;
            output.data[output.length] = 0;
            tunnel output -> std::string::String result;
        }
    }

    namespace toml
    {
        // Shaft decodes the source literal before this copy, avoiding a
        // second escape pass for `toml("...")`-style construction.
        def from_literal(std::string::view::View text) -> std::string::String result
        {
            tunnel std::string::String::from_view(text) -> std::string::String result;
        }

        // Decode a basic-string token read from TOML text. As with JSON,
        // source literals should use from_literal(...) instead.
        def unquote_basic(std::string::view::View encoded) -> bool decoded, ?-> std::string::String result
        {
            reserve bool decoded;
            reserve ?std::string::String result;
            std::json::unquote(encoded);
            tunnel decoded -> bool decoded;
            valid result
            {
                tunnel result -> std::string::String result;
            }
        }

        // TOML basic strings share JSON's byte-level escape set for quotes,
        // backslashes, and control bytes, including `\\u00XX` escapes.
        def quote_basic(std::string::view::View text) -> std::string::String result
        {
            tunnel std::json::quote(text) -> std::string::String result;
        }
    }

    namespace vector
    {
        struct<T> Vector
        {
            mut *T base;
            mut *T data;
            mut u64 length;
            mut u64 capacity;
            mut u64 element_size;

            @index data;
            @init base;
        }

        def init(&mut std::vector::Vector<T> vector, u64 requested)<T> -> bool result
        {
            vector.capacity = 8;
            while (vector.capacity < requested)
            {
                vector.capacity = vector.capacity * 2;
            }
            vector.element_size = sizeof(T);
            vector.base = __shaft_alloc_or_exit(vector.capacity * vector.element_size);
            @unsafe
            vector.data = vector.base;
            @end
            vector.length = 0;
            tunnel true -> bool result;
        }

        def data(*std::vector::Vector<T> vector)<T> -> *T result
        {
            tunnel vector.data -> *T result;
        }

        def push(&mut std::vector::Vector<T> vector, T value)<T> -> bool result
        {
            if (vector.length == vector.capacity)
            {
                mut u64 new_capacity = vector.capacity;
                if (new_capacity == 0)
                {
                    new_capacity = 8;
                }
                else
                {
                    new_capacity = new_capacity * 2;
                }
                mut *T new_data = __shaft_alloc_or_exit(new_capacity * vector.element_size);
                mut u64 offset = 0;
                while (offset < vector.length)
                {
                    new_data[offset] = move vector.data[offset];
                    offset = offset + 1;
                }
                __shaft_free(vector.base);
                vector.base = new_data;
                vector.data = new_data;
                vector.capacity = new_capacity;
            }
            vector.data[vector.length] = value;
            vector.length = vector.length + 1;
            tunnel true -> bool result;
        }

        def pop(&mut std::vector::Vector<T> vector)<T> ?-> T value
        {
            mut bool has_value = vector.length > 0;
            if (has_value)
            {
                vector.length = vector.length - 1;
                tunnel vector.data[vector.length] -> T value;
            }
        }

        def pop_front(&mut std::vector::Vector<T> vector)<T> ?-> T value
        {
            if (vector.length > 0)
            {
                T first = vector.data[0];
                vector.data = vector.data + 1;
                vector.length -= 1;
                vector.capacity -= 1;
                tunnel first -> T value;
            }
        }

        def reserve(&mut std::vector::Vector<T> vector, u64 requested)<T> -> bool result
        {
            mut bool reserved = true;
            if (requested > vector.capacity)
            {
                mut u64 new_capacity = vector.capacity;
                if (new_capacity == 0)
                {
                    new_capacity = 8;
                }
                while (new_capacity < requested)
                {
                    new_capacity = new_capacity * 2;
                }
                mut *T new_data = __shaft_alloc_or_exit(new_capacity * vector.element_size);
                mut u64 offset = 0;
                while (offset < vector.length)
                {
                    new_data[offset] = vector.data[offset];
                    offset = offset + 1;
                }
                __shaft_free(vector.base);
                vector.base = new_data;
                vector.data = new_data;
                vector.capacity = new_capacity;
            }
            tunnel reserved -> bool result;
        }

        impl<T> Vector<T>
        {
            def len(&self) -> u64 result
            {
                tunnel self.length -> u64 result;
            }

            def capacity(&self) -> u64 result
            {
                tunnel self.capacity -> u64 result;
            }

            def is_empty(&self) -> bool result
            {
                tunnel self.length == 0 -> bool result;
            }

            def push(&mut self, T value)<T> -> bool result
            {
                tunnel std::vector::push::<T>(self, value) -> bool result;
            }

            def pop(&mut self)<T> ?-> T value
            {
                reserve ?T value;
                std::vector::pop::<T>(self);
                valid value
                {
                    tunnel value -> T value;
                }
            }

            def pop_front(&mut self) ?-> T value
            {
                reserve ?T value;
                std::vector::pop_front::<T>(self);
                valid value
                {
                    tunnel value -> T value;
                }
            }
        }
    }

    namespace collections
    {
        struct<K, V> Pair{
            mut K key;
            mut V value;
        }

        struct<K, V> HashMap{
            mut *K keys;
            mut *V values;
            mut u8[] occupied;
            mut u64 length;
            mut u64 capacity;
            mut u64 key_size;
            mut u64 value_size;
        }

        struct<T> HashSet{
            mut *T values;
            mut u8[] occupied;
            mut u64 length;
            mut u64 capacity;
            mut u64 value_size;
        }

        def hash_u64(mut u64 value) -> u64 result
        {
            value = value ^ (value >> 30);
            value = value * 13787848793156543929;
            value = value ^ (value >> 27);
            value = value * 10723151780598845931;
            tunnel value ^ (value >> 31) -> u64 result;
        }

        def hash_str(std::string::view::View value) -> u64 result
        {
            mut u64 hashValue = 14695981039346656037;
            mut u64 offset = 0;
            while (offset < value.length)
            {
                hashValue = hashValue ^ value.data[offset];
                hashValue = hashValue * 1099511628211;
                offset = offset + 1;
            }
            tunnel hashValue -> u64 result;
        }

        def hash(T value)<T> -> u64 result
        {
            tunnel std::collections::hash_u64(value) -> u64 result;
        }

        def hash_map_u64_init(*std::collections::HashMap<u64, u64> map, u64 requested) -> bool result
        {
            map.capacity = 8;
            while (map.capacity < requested * 2)
            {
                map.capacity = map.capacity * 2;
            }
            map.key_size = 8;
            map.value_size = 8;
            map.keys = __shaft_alloc_or_exit(map.capacity * 8);
            map.values = __shaft_alloc_or_exit(map.capacity * 8);
            map.occupied = __shaft_alloc_or_exit(map.capacity);
            map.length = 0;
            mut u64 slot = 0;
            while (slot < map.capacity)
            {
                map.occupied[slot] = 0;
                slot = slot + 1;
            }
            tunnel true -> bool result;
        }

        def hash_map_u64_reserve(*std::collections::HashMap<u64, u64> map, u64 requested) -> bool result
        {
            if (requested * 2 > map.capacity)
            {
                mut u64 newCapacity = map.capacity;
                if (newCapacity < 8) { newCapacity = 8; }
                while (newCapacity < requested * 2) { newCapacity = newCapacity * 2; }
                mut *u64 newKeys = __shaft_alloc_or_exit(newCapacity * 8);
                mut *u64 newValues = __shaft_alloc_or_exit(newCapacity * 8);
                mut *u8 newOccupied = __shaft_alloc_or_exit(newCapacity);
                mut u64 slot = 0;
                while (slot < newCapacity) { newOccupied[slot] = 0; slot = slot + 1; }
                mut u64 oldSlot = 0;
                while (oldSlot < map.capacity)
                {
                    if (map.occupied[oldSlot] != 0)
                    {
                        slot = std::collections::hash_u64(map.keys[oldSlot]) & (newCapacity - 1);
                        while (newOccupied[slot] != 0) { slot = (slot + 1) & (newCapacity - 1); }
                        newOccupied[slot] = 1;
                        newKeys[slot] = map.keys[oldSlot];
                        newValues[slot] = map.values[oldSlot];
                    }
                    oldSlot = oldSlot + 1;
                }
                __shaft_free(map.keys); __shaft_free(map.values); __shaft_free(map.occupied);
                map.keys = newKeys; map.values = newValues; map.occupied = newOccupied; map.capacity = newCapacity;
            }
            tunnel true -> bool result;
        }

        def hash_map_u64_insert(*std::collections::HashMap<u64, u64> map, u64 key, u64 value) -> bool result
        {
            if (map.capacity != 0 && map.length + 1 > map.capacity / 2)
            {
                reserve bool grown = std::collections::hash_map_u64_reserve(map, map.length + 1);
            }
            mut bool inserted = false;
            if (map.capacity != 0)
            {
                mut u64 slot = std::collections::hash_u64(key) & (map.capacity - 1);
                mut u64 probes = 0;
                while (probes < map.capacity)
                {
                    if (map.occupied[slot] == 0)
                    {
                        map.occupied[slot] = 1;
                        map.keys[slot] = key;
                        map.values[slot] = value;
                        map.length = map.length + 1;
                        inserted = true;
                        break;
                    }
                    if (map.keys[slot] == key)
                    {
                        map.values[slot] = value;
                        inserted = true;
                        break;
                    }
                    slot = (slot + 1) & (map.capacity - 1);
                    probes = probes + 1;
                }
            }
            tunnel inserted -> bool result;
        }

        def hash_map_u64_contains(*std::collections::HashMap<u64, u64> map, u64 key) -> bool result
        {
            mut bool found = false;
            if (map.capacity != 0)
            {
                mut u64 slot = std::collections::hash_u64(key) & (map.capacity - 1);
                mut u64 probes = 0;
                while (probes < map.capacity)
                {
                    if (map.occupied[slot] == 0)
                    {
                        break;
                    }
                    if (map.keys[slot] == key)
                    {
                        found = true;
                        break;
                    }
                    slot = (slot + 1) & (map.capacity - 1);
                    probes = probes + 1;
                }
            }
            tunnel found -> bool result;
        }

        def hash_map_u64_get(*std::collections::HashMap<u64, u64> map, u64 key) -> u64 result
        {
            mut u64 value = 0;
            if (map.capacity != 0)
            {
                mut u64 slot = std::collections::hash_u64(key) & (map.capacity - 1);
                mut u64 probes = 0;
                while (probes < map.capacity)
                {
                    if (map.occupied[slot] == 0)
                    {
                        break;
                    }
                    if (map.keys[slot] == key)
                    {
                        value = map.values[slot];
                        break;
                    }
                    slot = (slot + 1) & (map.capacity - 1);
                    probes = probes + 1;
                }
            }
            tunnel value -> u64 result;
        }

        def hash_map_u64_len(*std::collections::HashMap<u64, u64> map) -> u64 result
        {
            tunnel map.length -> u64 result;
        }

        def hash_map_init(*std::collections::HashMap<K, V> map, u64 requested)<K, V> -> bool result
        {
            map.capacity = 8;
            while (map.capacity < requested * 2)
            {
                map.capacity = map.capacity * 2;
            }
            map.key_size = sizeof(K);
            map.value_size = sizeof(V);
            map.keys = __shaft_alloc_or_exit(map.capacity * map.key_size);
            map.values = __shaft_alloc_or_exit(map.capacity * map.value_size);
            map.occupied = __shaft_alloc_or_exit(map.capacity);
            map.length = 0;
            mut u64 slot = 0;
            while (slot < map.capacity)
            {
                map.occupied[slot] = 0;
