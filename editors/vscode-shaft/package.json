{
  "name": "shaft",
  "displayName": "Shaft",
  "description": "Language intelligence, compiler diagnostics, formatting, and editing support for Shaft.",
  "version": "0.1.0",
  "publisher": "shaft-lang",
  "license": "Apache-2.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "keywords": ["shaft", "systems", "llvm", "language-server"],
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage:shaft", "onCommand:shaft.restartLanguageServer", "onCommand:shaft.checkFile"],
  "contributes": {
    "languages": [{
      "id": "shaft",
      "aliases": ["Shaft", "shaft"],
      "extensions": [".shaft"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "shaft",
      "scopeName": "source.shaft",
      "path": "./syntaxes/shaft.tmLanguage.json"
    }],
    "snippets": [{ "language": "shaft", "path": "./snippets/shaft.code-snippets" }],
    "configuration": {
      "title": "Shaft",
      "properties": {
        "shaft.languageServer.serverPath": {
          "type": "string", "default": "", "scope": "resource",
          "description": "Optional absolute shaftls executable. When empty, uses shaftls on PATH."
        }
      }
    },
    "commands": [
      { "command": "shaft.restartLanguageServer", "title": "Shaft: Restart Language Server" },
      { "command": "shaft.openSyntaxSpecification", "title": "Shaft: Open Syntax Specification" }
    ]
  },
  "scripts": {
    "test": "node --test test/compiler-discovery.test.cjs test/extension-settings.test.cjs test/server-command.test.cjs test/shaft-language.test.cjs",
    "check": "node --check extension.cjs && node --check server/lib/extension-settings.cjs && node --check server/lib/server-command.cjs && npm test",
    "package": "node scripts/package-vsix.cjs"
  }
}
