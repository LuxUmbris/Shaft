@config.build.target = "aarch64-apple-macos"
@config.build.hosted = false
@asm
.text
.globl _start
_start:
    ldr w0, [sp]
    add x1, sp, #8
    bl __shaft_entry
    mov x16, #1
    svc #0x80
    brk #0
@end
@end
@asm
.globl __shaft_syscall6
__shaft_syscall6:
    mov x16, x0
    mov x0, x1
    mov x1, x2
    mov x2, x3
    mov x3, x4
    mov x4, x5
    mov x5, x6
    svc #0x80
    ret
@end
