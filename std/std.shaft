// Shaft std
using global cstr -> *u8;

namespace std
{

class str
{
    mut *u8 data;
    mut u64 length;
    def is_empty(&self) -> bool result
    {
        tunnel self.length == 0 -> bool result;
    }

    def find(&self, std::str needle) -> bool contains, ?-> u64 position
    {
        mut bool found = false;
        mut u64 foundPosition = 0;
        if (needle.length == 0)
        {
            found = true;
        }
        else
        {
            if (needle.length <= self.length)
            {
                mut u64 first = 0;
                while (first + needle.length <= self.length)
                {
                    mut u64 offset = 0;
                    mut bool matches = true;
                    while (offset < needle.length)
                    {
                        if (self.data[first + offset] != needle.data[offset])
                        {
                            matches = false;
                            break;
                        }
                        offset = offset + 1;
                    }
                    if (matches)
                    {
                        found = true;
                        foundPosition = first;
                        break;
                    }
                    first = first + 1;
                }
            }
        }
        tunnel found -> bool contains;
        if (found)
        {
            tunnel foundPosition -> u64 position;
        }
    }

    def substr(&self, u64 offset, u64 requested) -> std::str result
    {
        reserve mut std::str substring;
        if (offset < self.length)
        {
            mut u64 end = offset + requested;
            if (end > self.length)
            {
                end = self.length;
            }
            substring.data = __shaft_alloc_or_exit(end - offset + 1);
            substring.length = end - offset;
            mut u64 i = 0;
            while (i < substring.length)
            {
                substring.data[i] = self.data[offset + i];
                i = i + 1;
            }
            substring.data[substring.length] = 0;
        }
        else
        {
            substring.data = __shaft_alloc_or_exit(1);
            substring.length = 0;
            substring.data[0] = 0;
        }
        tunnel substring -> std::str result;
    }
}

namespace Math
{
    def round(f64 value) -> f64 result
    {
        mut f64 rounded = 0.0;
        mut f64 remainder = value;
        if (value >= 0.0)
        {
            while (remainder >= 1.0)
            {
                rounded = rounded + 1.0;
                remainder = remainder - 1.0;
            }
            if (remainder >= 0.5)
            {
                rounded = rounded + 1.0;
            }
        }
        else
        {
            while (remainder <= -1.0)
            {
                rounded = rounded - 1.0;
                remainder = remainder + 1.0;
            }
            if (remainder <= -0.5)
            {
                rounded = rounded - 1.0;
            }
        }
        tunnel rounded -> f64 result;
    }

    def square(f64 value) -> f64 result
    {
        tunnel value * value -> f64 result;
    }

    def sqrt(f64 value) -> f64 result
    {
        mut f64 estimate = 0.0;
        if (value > 0.0)
        {
            estimate = value;
            if (value < 1.0)
            {
                estimate = 1.0;
            }
            mut u64 iteration = 0;
            while (iteration < 16)
            {
                estimate = (estimate + value / estimate) / 2.0;
                iteration = iteration + 1;
            }
        }
        tunnel estimate -> f64 result;
    }

    def root(f64 value, u64 degree) -> f64 result
    {
        mut f64 estimate = 0.0;
        if (value > 0.0)
        {
            if (degree == 1)
            {
                estimate = value;
            }
            else
            {
                if (degree > 1)
                {
                    estimate = value;
                    if (value < 1.0)
                    {
                        estimate = 1.0;
                    }
                    mut f64 degreeValue = 0.0;
                    mut u64 count = 0;
                    while (count < degree)
                    {
                        degreeValue = degreeValue + 1.0;
                        count = count + 1;
                    }
                    mut u64 iteration = 0;
                    while (iteration < 24)
                    {
                        mut f64 priorPower = 1.0;
                        count = 0;
                        while (count < degree - 1)
                        {
                            priorPower = priorPower * estimate;
                            count = count + 1;
                        }
                        estimate = ((degreeValue - 1.0) * estimate + value / priorPower) / degreeValue;
                        iteration = iteration + 1;
                    }
                }
            }
        }
        tunnel estimate -> f64 result;
    }

    def cos(f64 radians) -> f64 result
    {
        mut f64 angle = radians;
        while (angle > 3.141592653589793)
        {
            angle = angle - 6.283185307179586;
        }
        while (angle < -3.141592653589793)
        {
            angle = angle + 6.283185307179586;
        }
        mut f64 term = 1.0;
        mut f64 sum = 1.0;
        mut f64 odd = 1.0;
        mut f64 even = 2.0;
        mut u64 iteration = 0;
        while (iteration < 10)
        {
            term = term * (0.0 - angle * angle) / (odd * even);
            sum = sum + term;
            odd = odd + 2.0;
            even = even + 2.0;
            iteration = iteration + 1;
        }
        tunnel sum -> f64 result;
    }

    def sin(f64 radians) -> f64 result
    {
        tunnel std::Math::cos(radians - 1.5707963267948966) -> f64 result;
    }
}

class String
{
    mut *u8 data;
    mut u64 length;
    mut u64 capacity;

    def len(&self) -> u64 result
    {
        tunnel self.length -> u64 result;
    }

    def is_empty(&self) -> bool result
    {
        tunnel self.length == 0 -> bool result;
    }

    def substr(&self, u64 offset, u64 requested) -> std::String result
    {
        reserve mut std::String substring;
        if (offset < self.length)
        {
            mut u64 end = offset + requested;
            if (end > self.length)
            {
                end = self.length;
            }
            substring.data = __shaft_alloc_or_exit(end - offset + 1);
            substring.capacity = end - offset;
            substring.length = end - offset;
            mut u64 i = 0;
            while (i < substring.length)
            {
                substring.data[i] = self.data[offset + i];
                i = i + 1;
            }
            substring.data[substring.length] = 0;
        }
        else
        {
            substring.data = __shaft_alloc_or_exit(1);
            substring.capacity = 0;
            substring.length = 0;
            substring.data[0] = 0;
        }
        tunnel substring -> std::String result;
    }

    def get_view(&self) -> std::str result
    {
        reserve mut std::str view;
        view.data = self.data;
        view.length = self.length;
        tunnel view -> std::str result;
    }

    def find(&self, std::str needle) -> bool contains, ?-> u64 position
    {
        mut bool found = false;
        mut u64 foundPosition = 0;
        if (needle.length == 0)
        {
            found = true;
        }
        else
        {
            if (needle.length <= self.length)
            {
                mut u64 first = 0;
                while (first + needle.length <= self.length)
                {
                    mut u64 offset = 0;
                    mut bool matches = true;
                    while (offset < needle.length)
                    {
                        if (self.data[first + offset] != needle.data[offset])
                        {
                            matches = false;
                            break;
                        }
                        offset = offset + 1;
                    }
                    if (matches)
                    {
                        found = true;
                        foundPosition = first;
                        break;
                    }
                    first = first + 1;
                }
            }
        }
        tunnel found -> bool contains;
        if (found)
        {
            tunnel foundPosition -> u64 position;
        }
    }

    def compare(&self, std::str other) -> i32 result
    {
        mut i32 comparison = 0;
        mut u64 offset = 0;
        mut u64 sharedLength = self.length;
        if (other.length < sharedLength)
        {
            sharedLength = other.length;
        }
        while (offset < sharedLength)
        {
            if (self.data[offset] < other.data[offset])
            {
                comparison = -1;
                break;
            }
            if (self.data[offset] > other.data[offset])
            {
                comparison = 1;
                break;
            }
            offset = offset + 1;
        }
        if (comparison == 0)
        {
            if (self.length < other.length)
            {
                comparison = -1;
            }
            if (self.length > other.length)
            {
                comparison = 1;
            }
        }
        tunnel comparison -> i32 result;
    }

    def equals(&self, std::str other) -> bool result
    {
        mut bool equal = self.length == other.length;
        mut u64 offset = 0;
        while (equal && offset < self.length)
        {
            if (self.data[offset] != other.data[offset])
            {
                equal = false;
                break;
            }
            offset = offset + 1;
        }
        tunnel equal -> bool result;
    }

    def hash(&self) -> u64 result
    {
        mut u64 value = 14695981039346656037;
        mut u64 offset = 0;
        while (offset < self.length)
        {
            value = value ^ self.data[offset];
            value = value * 1099511628211;
            offset = offset + 1;
        }
        tunnel value -> u64 result;
    }

    def reverse(&self) -> std::String result
    {
        reserve mut std::String reversed;
        reversed.data = __shaft_alloc_or_exit(self.length + 1);
        reversed.length = 0;
        reversed.capacity = self.length;
        mut u64 offset = 0;
        while (offset < self.length)
        {
            reversed.data[offset] = self.data[self.length - offset - 1];
            offset = offset + 1;
        }
        reversed.length = self.length;
        reversed.data[reversed.length] = 0;
        tunnel reversed -> std::String result;
    }

    def capacity(&self) -> u64 result
    {
        tunnel self.capacity -> u64 result;
    }

    def parse_u64(&self) -> bool parsed, ?-> u64 value
    {
        mut bool success = self.length > 0;
        mut u64 offset = 0;
        mut u64 resultValue = 0;
        while (success && offset < self.length)
        {
            mut u8 byte = self.data[offset];
            if (byte < 48 || byte > 57)
            {
                success = false;
            }
            else
            {
                mut u64 digit = byte - 48;
                if (resultValue > 1844674407370955161 ||
                    (resultValue == 1844674407370955161 && digit > 5))
                {
                    success = false;
                }
                else
                {
                    resultValue = resultValue * 10 + digit;
                }
            }
            offset = offset + 1;
        }
        tunnel success -> bool parsed;
        if (success)
        {
            tunnel resultValue -> u64 value;
        }
    }

    def parse_i64(&self) -> bool parsed, ?-> i64 value
    {
        mut u64 offset = 0;
        mut bool negative = false;
        if (self.length > 0 && self.data[0] == 45)
        {
            negative = true;
            offset = 1;
        }
        mut bool success = offset < self.length;
        mut u64 magnitude = 0;
        mut u64 limit = 9223372036854775807;
        if (negative)
        {
            limit = 9223372036854775808;
        }
        while (success && offset < self.length)
        {
            mut u8 byte = self.data[offset];
            if (byte < 48 || byte > 57)
            {
                success = false;
            }
            else
            {
                mut u64 digit = byte - 48;
                if (magnitude > limit / 10 || (magnitude == limit / 10 && digit > limit % 10))
                {
                    success = false;
                }
                else
                {
                    magnitude = magnitude * 10 + digit;
                }
            }
            offset = offset + 1;
        }
        tunnel success -> bool parsed;
        if (success)
        {
            if (negative)
            {
                tunnel 0 - magnitude -> i64 value;
            }
            else
            {
                tunnel magnitude -> i64 value;
            }
        }
    }

    def parse_f64(&self) -> bool parsed, ?-> f64 value
    {
        mut u64 offset = 0;
        mut bool negative = false;
        if (self.length > 0 && self.data[0] == 45)
        {
            negative = true;
            offset = 1;
        }
        mut bool success = offset < self.length;
        mut bool decimal = false;
        mut bool digits = false;
        mut bool fractionDigits = false;
        mut f64 resultValue = 0.0;
        mut f64 divisor = 1.0;
        while (success && offset < self.length)
        {
            mut u8 byte = self.data[offset];
            if (byte == 46)
            {
                if (decimal || !digits)
                {
                    success = false;
                }
                else
                {
                    decimal = true;
                }
            }
            else
            {
                if (byte < 48 || byte > 57)
                {
                    success = false;
                }
                else
                {
                    mut f64 digit = byte - 48;
                    digits = true;
                    if (decimal)
                    {
                        fractionDigits = true;
                        divisor = divisor * 10.0;
                        resultValue = resultValue + digit / divisor;
                    }
                    else
                    {
                        resultValue = resultValue * 10.0 + digit;
                    }
                }
            }
            offset = offset + 1;
        }
        if (decimal && !fractionDigits)
        {
            success = false;
        }
        tunnel success -> bool parsed;
        if (success)
        {
            if (negative)
            {
                tunnel 0.0 - resultValue -> f64 value;
            }
            else
            {
                tunnel resultValue -> f64 value;
            }
        }
    }

    def append(*std::String string, std::str value) -> bool result
    {
        mut bool was_resized = false;
        mut u64 new_capacity = string.capacity;
        while (new_capacity < string.length + value.length + 1)
        {
            was_resized = true;
            if (new_capacity == 0)
            {
                new_capacity = 8;
            }
            else
            {
                new_capacity *= 2;
            }
        }
        if (was_resized == true)
        {
            mut *u8 newData = __shaft_alloc_or_exit(new_capacity);

            for (mut u64 i = 0; i <= string.length; i += 1)
            {
                newData[i] = string.data[i];
            }
            string.data = move newData;
            string.capacity = new_capacity;
        }
        for (mut i32 i = 0; i < value.length; i += 1)
        {
            string.data[string.length + i] = value.data[i];
        }
        string.length = string.length + value.length;
        string.data[string.length] = 0;
        tunnel true -> bool result;
    }

    def append_string(&mut self, &std::String other) -> bool result
    {
        std::str buffer = {other.length, other.data};
        self.append(buffer);
        tunnel true -> bool result;
    }

    def append_cstr(&mut self, cstr value) -> bool result
    {
        mut u64 valueLength = 0;
        while (value[valueLength] != 0)
        {
            valueLength = valueLength + 1;
        }
        mut std::str buffer;
        buffer.data = value;
        buffer.length = valueLength;
        self.append(buffer);
        tunnel true -> bool result;
    }
}

namespace String
{
    def with_capacity(u64 requested) -> std::String result
    {
        reserve mut std::String value;
        value.data = __shaft_alloc(requested + 1);
        value.length = 0;
        value.capacity = requested;
        tunnel value -> std::String result;
    }

    def from_int(i64 value) -> std::String result
    {
        reserve mut std::String resultValue;
        resultValue.data = __shaft_alloc_or_exit(32);
        resultValue.capacity = 31;
        resultValue.length = __sys_int_to_string(
            value,
            resultValue.data,
            resultValue.capacity
        );
        resultValue.data[resultValue.length] = 0;
        tunnel resultValue -> std::String result;
    }

    def from_float(f64 value) -> std::String result
    {
        reserve mut std::String resultValue;
        resultValue.data = __shaft_alloc_or_exit(64);
        resultValue.capacity = 63;
        resultValue.length = __sys_float_to_string(
            value,
            resultValue.data,
            resultValue.capacity
        );
        resultValue.data[resultValue.length] = 0;
        tunnel resultValue -> std::String result;
    }

    def from_u64(u64 value) -> std::String result
    {
        reserve mut std::String resultValue;
        resultValue.data = __shaft_alloc_or_exit(32);
        resultValue.capacity = 31;
        resultValue.length = __sys_uint_to_string(value, resultValue.data, resultValue.capacity);
        resultValue.data[resultValue.length] = 0;
        tunnel resultValue -> std::String result;
    }

    def from_i8(i8 value) -> std::String result { tunnel std::String::from_int(value) -> std::String result; }
    def from_u8(u8 value) -> std::String result { tunnel std::String::from_u64(value) -> std::String result; }
    def from_i16(i16 value) -> std::String result { tunnel std::String::from_int(value) -> std::String result; }
    def from_u16(u16 value) -> std::String result { tunnel std::String::from_u64(value) -> std::String result; }
    def from_i32(i32 value) -> std::String result { tunnel std::String::from_int(value) -> std::String result; }
    def from_u32(u32 value) -> std::String result { tunnel std::String::from_u64(value) -> std::String result; }
    def from_i64(i64 value) -> std::String result { tunnel std::String::from_int(value) -> std::String result; }

    def from_usize(usize value) -> std::String result { tunnel std::String::from_u64(value) -> std::String result; }
    def from_f32(f32 value) -> std::String result { tunnel std::String::from_float(value) -> std::String result; }
    def from_f64(f64 value) -> std::String result { tunnel std::String::from_float(value) -> std::String result; }

    def from_bool(bool value) -> std::String result
    {
        reserve mut std::String resultValue;
        if (value)
        {
            resultValue.data = __shaft_alloc_or_exit(5); resultValue.capacity = 4; resultValue.length = 4;
            resultValue.data[0] = 116; resultValue.data[1] = 114; resultValue.data[2] = 117; resultValue.data[3] = 101;
        }
        else
        {
            resultValue.data = __shaft_alloc_or_exit(6); resultValue.capacity = 5; resultValue.length = 5;
            resultValue.data[0] = 102; resultValue.data[1] = 97; resultValue.data[2] = 108; resultValue.data[3] = 115; resultValue.data[4] = 101;
        }
        resultValue.data[resultValue.length] = 0;
        tunnel resultValue -> std::String result;
    }

    def from_char(char value) -> std::String result
    {
        reserve mut std::String resultValue;
        resultValue.data = __shaft_alloc_or_exit(2); resultValue.capacity = 1; resultValue.length = 1;
        resultValue.data[0] = value; resultValue.data[1] = 0;
        tunnel resultValue -> std::String result;
    }

    def from_str(std::str value) -> std::String result
    {
        reserve mut std::String resultValue;
        resultValue.data = __shaft_alloc_or_exit(value.length + 1);
        resultValue.capacity = value.length + 1;
        memcpy(resultValue.data, value.data, value.length);
        resultValue.length = value.length;
        resultValue.data[resultValue.length] = 0;
        tunnel resultValue -> std::String result;
    }
}

namespace str
{
    def from_cstr(cstr value) -> std::str result
    {
        reserve mut std::str resultValue;
        resultValue.length = __cstr_strlen(value);
        resultValue.data = value;
        tunnel resultValue -> std::str result;
    }
}

class<T> Vector
{
    mut *T data;
    mut u64 length;
    mut u64 capacity;
    mut u64 element_size;

    index data;
    init data;

    def len(&self) -> u64 result
    {
        tunnel self.length -> u64 result;
    }

    def capacity(&self) -> u64 result
    {
        tunnel self.capacity -> u64 result;
    }

    def is_empty(&self) -> bool result
    {
        tunnel self.length == 0 -> bool result;
    }

    def push(&mut self, T value)<T> -> bool result
    {
        tunnel std::vector_push::<T>(self, value) -> bool result;
    }

    def pop(&mut self)<T> -> bool popped, ?-> T value
    {
        reserve bool popped;
        reserve ?T value;
        std::vector_pop::<T>(self);
        tunnel popped -> bool popped;
        valid value
        {
            tunnel value -> T value;
        }
    }
}

def vector_init(*std::Vector<T> vector, u64 requested)<T> -> bool result
{
    vector.capacity = 8;
    while (vector.capacity < requested)
    {
        vector.capacity = vector.capacity * 2;
    }
    vector.element_size = sizeof(T);
    vector.data = __shaft_alloc_or_exit(vector.capacity * vector.element_size);
    vector.length = 0;
    tunnel true -> bool result;
}

def vector_data(*std::Vector<T> vector)<T> -> *T result
{
    tunnel vector.data -> *T result;
}

def vector_push(*std::Vector<T> vector, T value)<T> -> bool result
{
    if (vector.length == vector.capacity)
    {
        mut u64 new_capacity = vector.capacity;
        if (new_capacity == 0)
        {
            new_capacity = 8;
        }
        else
        {
            new_capacity = new_capacity * 2;
        }
        mut *T newData = __shaft_alloc_or_exit(new_capacity * vector.element_size);
        mut u64 offset = 0;
        while (offset < vector.length)
        {
            newData[offset] = move vector.data[offset];
            offset = offset + 1;
        }
        __shaft_free(vector.data);
        vector.data = newData;
        vector.capacity = new_capacity;
    }
    vector.data[vector.length] = value;
    vector.length = vector.length + 1;
    tunnel true -> bool result;
}

def vector_pop(*std::Vector<T> vector)<T> -> bool popped, ?-> T value
{
    mut bool hasValue = vector.length > 0;
    tunnel hasValue -> bool popped;
    if (hasValue)
    {
        vector.length = vector.length - 1;
        tunnel vector.data[vector.length] -> T value;
    }
}

def vector_reserve(*std::Vector<T> vector, u64 requested)<T> -> bool result
{
    mut bool reserved = true;
    if (requested > vector.capacity)
    {
        mut u64 newCapacity = vector.capacity;
        if (newCapacity == 0)
        {
            newCapacity = 8;
        }
        while (newCapacity < requested)
        {
            newCapacity = newCapacity * 2;
        }
        mut *T newData = __shaft_alloc_or_exit(newCapacity * vector.element_size);
        mut u64 offset = 0;
        while (offset < vector.length)
        {
            newData[offset] = vector.data[offset];
            offset = offset + 1;
        }
        __shaft_free(vector.data);
        vector.data = newData;
        vector.capacity = newCapacity;
    }
    tunnel reserved -> bool result;
}

namespace Collections
{
    class<K, V> Pair
    {
        mut K key;
        mut V value;
    }

    class<K, V> HashMap
    {
        mut *K keys;
        mut *V values;
        mut u8[] occupied;
        mut u64 length;
        mut u64 capacity;
        mut u64 key_size;
        mut u64 value_size;
    }

    class<T> HashSet
    {
        mut *T values;
        mut u8[] occupied;
        mut u64 length;
        mut u64 capacity;
        mut u64 value_size;
    }

    def hash_u64(mut u64 value) -> u64 result
    {
        value = value ^ (value >> 30);
        value = value * 13787848793156543929;
        value = value ^ (value >> 27);
        value = value * 10723151780598845931;
        tunnel value ^ (value >> 31) -> u64 result;
    }

    def hash_str(std::str value) -> u64 result
    {
        mut u64 hashValue = 14695981039346656037;
        mut u64 offset = 0;
        while (offset < value.length)
        {
            hashValue = hashValue ^ value.data[offset];
            hashValue = hashValue * 1099511628211;
            offset = offset + 1;
        }
        tunnel hashValue -> u64 result;
    }

    def hash(T value)<T> -> u64 result
    {
        tunnel std::Collections::hash_u64(value) -> u64 result;
    }

    def hash_map_u64_init(*std::Collections::HashMap<u64, u64> map, u64 requested) -> bool result
    {
        map.capacity = 8;
        while (map.capacity < requested * 2)
        {
            map.capacity = map.capacity * 2;
        }
        map.key_size = 8;
        map.value_size = 8;
        map.keys = __shaft_alloc_or_exit(map.capacity * 8);
        map.values = __shaft_alloc_or_exit(map.capacity * 8);
        map.occupied = __shaft_alloc_or_exit(map.capacity);
        map.length = 0;
        mut u64 slot = 0;
        while (slot < map.capacity)
        {
