// macOS freestanding runtime, implemented in Shaft.
// The target-specific assembly supplies the kernel ABI; every runtime API is
// otherwise ordinary Shaft code in this module.

@config.build.target = "x86_64-apple-macos"
@config.build.hosted = false
@asm
.text
.globl _start
_start:
    mov (%rsp), %edi
    lea 8(%rsp), %rsi
    and $-16, %rsp
    call __shaft_entry
    mov %eax, %edi
    mov $0x2000001, %eax
    syscall
    ud2
@end
@end
@asm
.globl __shaft_syscall6
__shaft_syscall6:
    mov %rdi, %rax
    or $0x2000000, %rax
    mov %rsi, %rdi
    mov %rdx, %rsi
    mov %rcx, %rdx
    mov %r8, %r10
    mov %r9, %r8
    mov 8(%rsp), %r9
    syscall
    ret
@end
mut u64 runtime_sys_read = 3;
mut u64 runtime_sys_write = 4;
mut u64 runtime_sys_open = 5;
mut u64 runtime_sys_close = 6;
mut u64 runtime_sys_lseek = 199;
mut u64 runtime_sys_mmap = 197;
mut u64 runtime_sys_munmap = 73;
mut u64 runtime_sys_socket = 97;
mut u64 runtime_sys_connect = 98;
mut u64 runtime_sys_accept = 30;
mut u64 runtime_sys_sendto = 133;
mut u64 runtime_sys_recvfrom = 29;
mut u64 runtime_sys_shutdown = 134;
mut u64 runtime_sys_bind = 104;
mut u64 runtime_sys_listen = 106;
mut u64 runtime_sys_fcntl = 92;
mut u64 runtime_sys_clock_gettime = 116;
mut u64 runtime_sys_nanosleep = 240;
mut u64 runtime_sys_exit = 1;
@end

