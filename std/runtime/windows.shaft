}

@config.build.target = "x86_64-w64-windows-gnu"
@asm
.text
.globl mainCRTStartup
mainCRTStartup:
    subq $32, %rsp
    xorl %ecx, %ecx
    xorl %edx, %edx
    callq __shaft_entry
    movl %eax, %ecx
    callq ExitProcess
    int3
@end
@end

@config.build.target = "aarch64-w64-windows-gnu"
@asm
