cdef __sys_float_to_string(f64 value, *u8 output, u64 capacity) -> u64
{
    if (value != value)
    {
        if (capacity < 3)
        {
            return 0;
        }
        output[0] = 110;
        output[1] = 97;
        output[2] = 110;
        return 3;
    }
    mut bool negative = value < 0.0;
    mut f64 magnitude = value;
    if (negative)
    {
        magnitude = 0.0 - value;
    }
    if (magnitude > 9223372036854774784.0)
    {
        return 0;
    }
    mut u64 whole = magnitude as u64;
    mut u64 fraction = ((magnitude - whole) * 1000000.0 + 0.5) as u64;
    if (fraction == 1000000)
    {
        whole = whole + 1;
        fraction = 0;
    }
    mut u8[20] digits;
    mut u64 digit_count = __runtime_decimal_u64(whole, &digits[0]);
    mut u64 total = digit_count + 7;
    if (negative)
    {
        total = total + 1;
    }
    if (total > capacity)
    {
        return 0;
    }
    mut u64 offset = 0;
    if (negative)
    {
        output[offset] = 45;
        offset = offset + 1;
    }
    memcpy(&output[offset], &digits[0], digit_count);
    offset = offset + digit_count;
    output[offset] = 46;
    offset = offset + 1;
    mut u64 divisor = 100000;
    while (divisor != 0)
    {
        output[offset] = (48 + ((fraction / divisor) % 10)) as u8;
        offset = offset + 1;
        divisor = divisor / 10;
    }
