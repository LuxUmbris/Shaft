.globl __shaft_runtime_lock
__shaft_runtime_lock:
    la t0, runtime_lock
1:
    li t1, 1
    amoswap.d.aq t2, t1, (t0)
    bnez t2, 1b
    ret
.globl __shaft_runtime_unlock
__shaft_runtime_unlock:
    la t0, runtime_lock
    fence rw, w
    sd zero, 0(t0)
    ret
@end
