struct TimePoint
{
    i64 seconds;
    i64 nanoseconds;
}

class File
{
    i64 descriptor;
}

class Channel
{
    *u8 state;
    u64 element_size;
}

// unsafe
namespace Memory
{
    cdec memcpy(*u8 destination, *u8 source, u64 count) -> *u8;
    cdec memmove(*u8 destination, *u8 source, u64 count) -> *u8;
    cdec memset(*u8 destination, i32 value, u64 count) -> *u8;
    cdec memcmp(*u8 left, *u8 right, u64 count) -> i32;
}

namespace Math
{
    def min(u64 left, u64 right) -> u64 result
    {
        if (left < right)
        {
            tunnel left -> u64 result;
        }
        else
        {
            tunnel right -> u64 result;
        }
    }

    def max(u64 left, u64 right) -> u64 result
    {
        if (left > right)
        {
            tunnel left -> u64 result;
        }
        else
        {
            tunnel right -> u64 result;
        }
    }

    def clamp(u64 value, u64 lower, u64 upper) -> u64 result
    {
        if (value < lower)
        {
            tunnel lower -> u64 result;
        }
        else if (value > upper)
        {
            tunnel upper -> u64 result;
        }
        else
        {
            tunnel value -> u64 result;
        }
    }
}

namespace Time
{
    def now() -> TimePoint result
    {
        reserve TimePoint value;
        __sys_gettime_parts(&value.seconds, &value.nanoseconds);
        tunnel value -> TimePoint result;
    }

    def unix_seconds() -> i64 result
    {
        reserve TimePoint value = Time::now();
        tunnel value.seconds -> i64 result;
    }
}

def write(i32 descriptor, str content) -> i64 result
{
    tunnel __sys_write(descriptor, content.data, content.length) -> i64 result;
}

def print(str content) -> i64 result
{
    tunnel write(1, content) -> i64 result;
}

def println(str content) -> i64 result
{
    reserve i64 ignored = write(1, content);
    tunnel __sys_write(1, "\n", 1) -> i64 result;
}

def eprint(str content) -> i64 result
{
    tunnel write(2, content) -> i64 result;
}

def eprintln(str content) -> i64 result
{
    reserve i64 ignored = write(2, content);
    tunnel __sys_write(2, "\n", 1) -> i64 result;
}

using global print!(content) -> print(content);
using global println!(content) -> println(content);

cdec __sys_write(i64 fd, *i8 buffer, u64 count) -> i64;
cdec __shaft_alloc(u64 count) -> *u8;
cdec __shaft_alloc_or_exit(u64 count) -> *u8;
cdec __shaft_free(*u8 pointer);
cdec __sys_int_to_string(i64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_uint_to_string(u64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_float_to_string(f64 value, *u8 buffer, u64 capacity) -> u64;
cdec __sys_exit(i32 status);
cdec exit(i32 status);
cdec __sys_gettime_parts(*i64 seconds, *i64 nanoseconds) -> i32;
cdec __cstr_strlen(*i8 text) -> u64;
cdec __main(String[] args);

cdef __shaft_entry(i32 argc, **i8 argv) -> i32
{
    mut String[] args = __shaft_alloc_or_exit(argc * 24);
    mut u64 argumentIndex = 0;
    while (argumentIndex < argc)
    {
        *i8 text = argv[argumentIndex];
        u64 length = __cstr_strlen(text);
        args[argumentIndex].data = __shaft_alloc_or_exit(length + 1);
        args[argumentIndex].length = length;
        args[argumentIndex].capacity = length;
        memcpy(args[argumentIndex].data, text, length);
        argumentIndex = argumentIndex + 1;
    }
    __main(args);
    return 0;
}

cdec __sys_open(*i8 pathname, i32 mode) -> i64;
cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;
cdec __sys_readline(*u8 buffer, u64 capacity) -> i64;
cdec __sys_close(i64 descriptor) -> i64;
cdec __sys_file_size(i64 descriptor) -> i64;

def readline() -> String result
{
    reserve mut String line = String::with_capacity(65536);
    reserve i64 length = __sys_readline(line.data, line.capacity);
    if (length < 0)
    {
        line.length = 0;
    }
    else
    {
        line.length = length;
    }
    line.data[line.length] = 0;
    tunnel line -> String result;
}

cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;

def read_bytes(u64 requested) -> String result
{
    // allocate raw buffer
    mut *i8 buffer = __shaft_alloc_or_exit(requested);

    mut u64 total = 0;

    while (total < requested)
    {
        i64 n = __sys_read(
            0,
            buffer + total,
            requested - total
        );

        if (n <= 0)
        {
            break;
        }

        total = total + n;
    }

    str slice = { buffer, total };
    reserve String s = String::from_str(slice);

    tunnel s -> String result;
}

namespace File
{
    def read_into(str pathname, *u8 buffer, u64 capacity) -> i64 result
    {
        mut i64 received = 0;
        reserve i64 descriptor = __sys_open(pathname.data, 0);
        if (descriptor >= 0)
        {
            while (received < capacity)
            {
                reserve i64 count = __sys_read(descriptor, &buffer[received], capacity - received);
                if (count <= 0)
                {
                    break;
                }
                received = received + count;
            }
            __sys_close(descriptor);
        }
        tunnel received -> i64 result;
    }

    def read(str pathname) -> String result
    {
        reserve mut String content;
        reserve i64 descriptor = __sys_open(pathname.data, 0);
        if (descriptor >= 0)
        {
            reserve i64 size = __sys_file_size(descriptor);
            if (size >= 0)
            {
                content = String::with_capacity(size);
                mut u64 received = 0;
                while (received < size)
                {
                    reserve i64 count = __sys_read(descriptor, &content.data[received], size - received);
                    if (count <= 0)
                    {
                        break;
                    }
                    received = received + count;
                }
                content.length = received;
                content.data[received] = 0;
            }
            __sys_close(descriptor);
        }
        tunnel content -> String result;
    }

    def write_at_mode(str pathname, str content, i32 openMode) -> i64 result
    {
        mut i64 total = 0;
        reserve i64 descriptor = __sys_open(pathname.data, openMode);
        if (descriptor >= 0)
        {
            while (total < content.length)
            {
                reserve i64 count = __sys_write(descriptor, &content.data[total], content.length - total);
                if (count <= 0)
                {
                    break;
                }
                total = total + count;
            }
            __sys_close(descriptor);
        }
        tunnel total -> i64 result;
    }

    def write(str pathname, str content) -> i64 result
    {
        tunnel File::write_at_mode(pathname, content, 1) -> i64 result;
    }

    def append(str pathname, str content) -> i64 result
    {
        tunnel File::write_at_mode(pathname, content, 3) -> i64 result;
    }
}

namespace Network
{
    class Socket
    {
        mut i64 descriptor;
    }

    cdec __sys_socket(i32 domain, i32 type, i32 protocol) -> i64;
    cdec __sys_connect(i64 descriptor, *u8 address, u32 addressLength) -> i64;
    cdec __sys_bind(i64 descriptor, *u8 address, u32 addressLength) -> i64;
    cdec __sys_listen(i64 descriptor, i32 backlog) -> i64;
    cdec __sys_accept(i64 descriptor, *u8 address, *u32 addressLength) -> i64;
    cdec __sys_send(i64 descriptor, *u8 buffer, u64 length, i32 flags) -> i64;
    cdec __sys_recv(i64 descriptor, *u8 buffer, u64 length, i32 flags) -> i64;
    cdec __sys_sendto(i64 descriptor, *u8 buffer, u64 length, i32 flags, *u8 destination, u32 destinationLength) -> i64;
    cdec __sys_recvfrom(i64 descriptor, *u8 buffer, u64 length, i32 flags, *u8 source, *u32 sourceLength) -> i64;
    cdec __sys_shutdown(i64 descriptor, i32 how) -> i64;
    cdec __sys_socket_close(i64 descriptor) -> i64;
    cdec __sys_tcp_socket() -> i64;
    cdec __sys_udp_socket() -> i64;
    cdec __sys_tcp_connect_ipv4(i64 descriptor, u32 address, u16 port) -> i64;
    cdec __sys_tcp_listen_ipv4(u32 address, u16 port, i32 backlog) -> i64;
    cdec __sys_socket_accept(i64 descriptor) -> i64;
    cdec __sys_socket_set_nonblocking(i64 descriptor) -> i64;
    cdec __sys_socket_try_accept(i64 descriptor) -> i64;
    cdec __sys_socket_try_send(i64 descriptor, *u8 buffer, u64 length) -> i64;
    cdec __sys_socket_try_recv(i64 descriptor, *u8 buffer, u64 length) -> i64;

    def ipv4(u32 first, u32 second, u32 third, u32 fourth) -> u32 result
    {
        tunnel (first << 24) | (second << 16) | (third << 8) | fourth -> u32 result;
    }

    def tcp() -> Network::Socket result
    {
        reserve mut Network::Socket socket;
        socket.descriptor = __sys_tcp_socket();
        tunnel socket -> Network::Socket result;
    }

    def udp() -> Network::Socket result
    {
        reserve mut Network::Socket socket;
        socket.descriptor = __sys_udp_socket();
        tunnel socket -> Network::Socket result;
    }

    def tcp_connect_ipv4(u32 address, u16 port) -> Network::Socket result
    {
        reserve mut Network::Socket socket = Network::tcp();
        if (socket.descriptor >= 0)
        {
            reserve i64 connected = __sys_tcp_connect_ipv4(socket.descriptor, address, port);
            if (connected != 0)
            {
                __sys_socket_close(socket.descriptor);
                socket.descriptor = -1;
            }
        }
        tunnel socket -> Network::Socket result;
    }

    def tcp_listen_ipv4(u32 address, u16 port, i32 backlog) -> Network::Socket result
    {
        reserve mut Network::Socket socket;
        socket.descriptor = __sys_tcp_listen_ipv4(address, port, backlog);
        tunnel socket -> Network::Socket result;
    }

    def accept(*Network::Socket listener) -> Network::Socket result
    {
        reserve mut Network::Socket socket;
        socket.descriptor = __sys_socket_accept(listener.descriptor);
        tunnel socket -> Network::Socket result;
    }

    def set_nonblocking(*Network::Socket socket) -> i64 result
    {
        tunnel __sys_socket_set_nonblocking(socket.descriptor) -> i64 result;
    }

    def try_accept(*Network::Socket listener) -> Network::Socket result
    {
        reserve mut Network::Socket socket;
        socket.descriptor = __sys_socket_try_accept(listener.descriptor);
        tunnel socket -> Network::Socket result;
    }

    def try_send(*Network::Socket socket, str content) -> i64 result
    {
        tunnel __sys_socket_try_send(socket.descriptor, content.data, content.length) -> i64 result;
    }

    def try_receive(*Network::Socket socket, *u8 buffer, u64 capacity) -> i64 result
    {
        tunnel __sys_socket_try_recv(socket.descriptor, buffer, capacity) -> i64 result;
    }

    def send(*Network::Socket socket, str content) -> i64 result
    {
        mut i64 total = 0;
        while (total < content.length)
        {
            reserve i64 written = __sys_send(
                socket.descriptor,
                &content.data[total],
                content.length - total,
                0
            );
            if (written <= 0)
            {
                break;
            }
            total = total + written;
        }
        tunnel total -> i64 result;
    }

    def receive(*Network::Socket socket, *u8 buffer, u64 capacity) -> i64 result
    {
        tunnel __sys_recv(socket.descriptor, buffer, capacity, 0) -> i64 result;
    }

    def shutdown(*Network::Socket socket, i32 how) -> i64 result
    {
        tunnel __sys_shutdown(socket.descriptor, how) -> i64 result;
    }

    def close(*Network::Socket socket) -> i64 result
    {
        mut i64 closed = 0;
        if (socket.descriptor >= 0)
        {
            closed = __sys_socket_close(socket.descriptor);
            socket.descriptor = -1;
        }
        tunnel closed -> i64 result;
    }
}