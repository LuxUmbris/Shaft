// Linux freestanding runtime, implemented in Shaft.
// The target-specific assembly supplies the kernel ABI; every runtime API is
// otherwise ordinary Shaft code in this module.

@config.build.target = "x86_64-pc-linux-gnu"
@config.build.hosted = false
@asm
.text
.globl _start
_start:
    mov (%rsp), %edi
    lea 8(%rsp), %rsi
    and $-16, %rsp
    call __shaft_entry
    mov %eax, %edi
    mov $60, %eax
    syscall
    ud2
@end
@end
@asm
.globl __shaft_syscall6
__shaft_syscall6:
    mov %rdi, %rax
    mov %rsi, %rdi
    mov %rdx, %rsi
    mov %rcx, %rdx
    mov %r8, %r10
    mov %r9, %r8
    mov 8(%rsp), %r9
    syscall
    ret
@end
@asm
.globl __shaft_thread_clone
__shaft_thread_clone:
    push %r12
    push %r13
    mov %rsi, %r12
    mov 16(%rsp), %r13
    lea 65536(%rdi), %rsi
    and $-16, %rsi
    sub $8, %rsi
    mov %r13, (%rsi)
    mov (%rsp), %rax
    mov %rax, 8(%rsi)
    mov 8(%rsp), %rax
    mov %rax, 16(%rsi)
    mov $0x1350f00, %rdi
    mov %r12, %rdx
    mov %r12, %r10
    xor %r8, %r8
    mov $56, %rax
    syscall
    test %rax, %rax
    jnz 1f
    mov 8(%rsp), %r13
    mov 16(%rsp), %r12
    ret
1:
    pop %r13
    pop %r12
    ret
@end
@asm
.globl __shaft_runtime_lock
__shaft_runtime_lock:
    mov $1, %rax
1:
    xchg %rax, runtime_lock(%rip)
    test %rax, %rax
    jz 2f
    pause
    mov $1, %rax
    jmp 1b
2:
    ret
.globl __shaft_runtime_unlock
__shaft_runtime_unlock:
    movq $0, runtime_lock(%rip)
    ret
@end
mut u64 runtime_sys_read = 0;
