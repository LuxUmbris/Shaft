mut RuntimeAllocation[1024] initial_runtime_allocations;
mut *u8 runtime_null;
mut u64 runtime_lock = 0;
mut HeapChunk initial_chunk;
mut u64 runtime_heap_head;
mut bool runtime_heap_initialized = false;
mut u8[4096] runtime_stdin_buffer;
