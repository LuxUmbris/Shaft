@config.build.hosted = false
@asm
.text
.globl _start
_start:
    ld a0, 0(sp)
    addi a1, sp, 8
    call __shaft_entry
    li a7, 93
    ecall
    ebreak
.globl __shaft_syscall6
__shaft_syscall6:
    mv a7, a0
    mv a0, a1
    mv a1, a2
    mv a2, a3
    mv a3, a4
    mv a4, a5
    mv a5, a6
    ecall
    ret
@end
