    def str_equal(std::str left, std::str right) -> bool result
    {
        mut bool equal = left.length == right.length;
        mut u64 offset = 0;
        while (equal && offset < left.length)
        {
            if (left.data[offset] != right.data[offset])
            {
                equal = false;
                break;
            }
            offset = offset + 1;
        }
        tunnel equal -> bool result;
    }

