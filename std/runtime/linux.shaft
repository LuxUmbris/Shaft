@config.build.target = "aarch64-unknown-linux-gnu"
@config.build.hosted = false
@asm
.text
.globl _start
_start:
    ldr w0, [sp]
    add x1, sp, #8
    bl __shaft_entry
    mov x8, #93
    svc #0
    brk #0
@end
@end
@asm
.globl __shaft_syscall6
__shaft_syscall6:
    mov x8, x0
    mov x0, x1
    mov x1, x2
    mov x2, x3
    mov x3, x4
    mov x4, x5
    mov x5, x6
    svc #0
    ret
@end
@asm
.globl __shaft_runtime_lock
__shaft_runtime_lock:
    adrp x1, runtime_lock
    add x1, x1, :lo12:runtime_lock
1:
    ldaxr x2, [x1]
    cbnz x2, 1b
    mov x2, #1
    stxr w3, x2, [x1]
    cbnz w3, 1b
    ret
.globl __shaft_runtime_unlock
__shaft_runtime_unlock:
    adrp x1, runtime_lock
    add x1, x1, :lo12:runtime_lock
    stlr xzr, [x1]
    ret
@end
