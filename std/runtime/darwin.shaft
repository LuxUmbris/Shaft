ldr x0, [x19]
cbz x0, 1f
mov x1, xzr
bl _pthread_join
cbnz x0, 2f
str xzr, [x19]
2:
ldp x19, x30, [sp], #16
ret
1:
mov x0, #0
ldp x19, x30, [sp], #16
ret
