@config.build.target in ["x86_64-apple-darwin", "x86_64-macos-darwin", "x86_64-unsupported-darwin"]
@asm
.text
.globl __shaft_runtime_lock
__shaft_runtime_lock:
mov $1, %rax
1:
xchg %rax, runtime_lock(%rip)
test %rax, %rax
jz 2f
pause
mov $1, %rax
jmp 1b
2:
ret
.globl __shaft_runtime_unlock
__shaft_runtime_unlock:
movq $0, runtime_lock(%rip)
ret
.globl __shaft_thread_create
__shaft_thread_create:
mov %rsi, %r8
mov %rdx, %r9
mov %rcx, %rdi
xor %esi, %esi
mov %r8, %rdx
mov %r9, %rcx
sub $8, %rsp
call _pthread_create
add $8, %rsp
ret
.globl __sys_thread_join
__sys_thread_join:
push %r12
mov %rdi, %r12
mov (%r12), %rdi
test %rdi, %rdi
jz 1f
xor %esi, %esi
call _pthread_join
test %eax, %eax
jnz 2f
movq $0, (%r12)
2:
pop %r12
ret
1:
xor %eax, %eax
pop %r12
ret
@end
@end

