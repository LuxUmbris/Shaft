    // unsafe
    namespace memory
    {
        cdec memcpy(*u8 destination, *u8 source, u64 count) -> *u8;
        cdec memmove(*u8 destination, *u8 source, u64 count) -> *u8;
        cdec memset(*u8 destination, i32 value, u64 count) -> *u8;
        cdec memcmp(*u8 left, *u8 right, u64 count) -> i32;

        struct<T> Box
        {
            *T value;

            @init value;
            @index value;
        }

        impl<T> Box<T>
        {
            def new(T value) -> std::memory::Box<T> box
            {
                *T payload = __shaft_alloc_or_exit(sizeof(T));
                std::memory::Box<T> b = {payload};
                tunnel b -> std::memory::Box<T> box;
            }

            def inner(&self) -> T result
            {
                tunnel self.value -> T result;
            }

            def deref(&self) -> &T result
            {
                &T reference = ref self.value;
                tunnel reference -> &T result;
            }
        }

        struct<T> RcBox
        {
            mut T value;
            mut usize count;
        }

        struct<T> Rc
        {
            *std::memory::RcBox<T> ptr;
        }

        impl<T> Rc<T>
        {
            def new(T value) -> std::memory::Rc<T> rc
            {
                *std::memory::RcBox<T> boxed = __shaft_alloc_or_exit(sizeof(std::memory::RcBox<T>));
                (*boxed).value = value;
                (*boxed).count = 1;
                std::memory::Rc<T> ref_counter = {boxed};
                tunnel ref_counter -> std::memory::Rc<T> rc;
            }

            def clone(&self) -> std::memory::Rc<T> rc
            {
                (*self.ptr).count += 1;
                std::memory::Rc<T> ref_counter = {self.ptr};
                tunnel ref_counter -> std::memory::Rc<T> rc;
            }

            def ptr(&self) -> *T ptr
            {
                tunnel self.ptr -> *T ptr;
            }
        }

        struct<T> Arc
        {
            *std::memory::RcBox<T> ptr;
        }

        impl<T> Arc<T>
        {
            def new(T value) -> std::memory::Arc<T> arc
            {
                __shaft_runtime_lock();
                *std::memory::RcBox<T> boxed = __shaft_alloc_or_exit(sizeof(std::memory::RcBox<T>));
                (*boxed).value = value;
                (*boxed).count = 1;
                std::memory::Arc<T> ref_counter = {boxed};
                tunnel ref_counter -> std::memory::Arc<T> arc;
                __shaft_runtime_unlock();
            }

            def clone(&self) -> std::memory::Arc<T> arc
            {
                __shaft_runtime_lock();
                (*self.ptr).count += 1;
                std::memory::Arc<T> ref_counter = {self.ptr};
                tunnel ref_counter -> std::memory::Arc<T> arc;
                __shaft_runtime_unlock();
            }

            def ptr(&self) -> *T ptr
            {
                tunnel self.ptr -> *T ptr;
            }
        }
    }

    namespace math
    {
        def min(u64 left, u64 right) -> u64 result
        {
            if (left < right)
            {
                tunnel left -> u64 result;
            }
            else
            {
                tunnel right -> u64 result;
            }
        }

        def max(u64 left, u64 right) -> u64 result
        {
            if (left > right)
            {
                tunnel left -> u64 result;
            }
            else
            {
                tunnel right -> u64 result;
            }
        }

        def clamp(u64 value, u64 lower, u64 upper) -> u64 result
        {
            if (value < lower)
            {
                tunnel lower -> u64 result;
            }
            else if (value > upper)
            {
                tunnel upper -> u64 result;
            }
            else
            {
                tunnel value -> u64 result;
            }
        }

        def round(f64 value) -> f64 result
        {
            mut f64 rounded = 0.0;
            mut f64 remainder = value;
            if (value >= 0.0)
            {
                while (remainder >= 1.0)
                {
                    rounded = rounded + 1.0;
                    remainder = remainder - 1.0;
                }
                if (remainder >= 0.5)
                {
                    rounded = rounded + 1.0;
                }
            }
            else
            {
                while (remainder <= -1.0)
                {
                    rounded = rounded - 1.0;
                    remainder = remainder + 1.0;
                }
                if (remainder <= -0.5)
                {
                    rounded = rounded - 1.0;
                }
            }
            tunnel rounded -> f64 result;
        }

        def square(f64 value) -> f64 result
        {
            tunnel value * value -> f64 result;
        }

        def sqrt(f64 value) -> f64 result
        {
            mut f64 estimate = 0.0;
            if (value > 0.0)
            {
                estimate = value;
                if (value < 1.0)
                {
                    estimate = 1.0;
                }
                mut u64 iteration = 0;
                while (iteration < 16)
                {
                    estimate = (estimate + value / estimate) / 2.0;
                    iteration = iteration + 1;
                }
            }
            tunnel estimate -> f64 result;
        }

        def root(f64 value, u64 degree) -> f64 result
        {
            mut f64 estimate = 0.0;
            if (value > 0.0)
            {
                if (degree == 1)
                {
                    estimate = value;
                }
                else
                {
                    if (degree > 1)
                    {
                        estimate = value;
                        if (value < 1.0)
                        {
                            estimate = 1.0;
                        }
                        mut f64 degreeValue = 0.0;
                        mut u64 count = 0;
                        while (count < degree)
                        {
                            degreeValue = degreeValue + 1.0;
                            count = count + 1;
                        }
                        mut u64 iteration = 0;
                        while (iteration < 24)
                        {
                            mut f64 priorPower = 1.0;
                            count = 0;
                            while (count < degree - 1)
                            {
                                priorPower = priorPower * estimate;
                                count = count + 1;
                            }
                            estimate = ((degreeValue - 1.0) * estimate + value / priorPower) / degreeValue;
                            iteration = iteration + 1;
                        }
                    }
                }
            }
            tunnel estimate -> f64 result;
        }

        def cos(f64 radians) -> f64 result
        {
            mut f64 angle = radians;
            while (angle > 3.141592653589793)
            {
                angle = angle - 6.283185307179586;
            }
            while (angle < -3.141592653589793)
            {
                angle = angle + 6.283185307179586;
            }
            mut f64 term = 1.0;
            mut f64 sum = 1.0;
            mut f64 odd = 1.0;
            mut f64 even = 2.0;
            mut u64 iteration = 0;
            while (iteration < 10)
            {
                term = term * (0.0 - angle * angle) / (odd * even);
                sum = sum + term;
                odd = odd + 2.0;
                even = even + 2.0;
                iteration = iteration + 1;
            }
            tunnel sum -> f64 result;
        }

        def sin(f64 radians) -> f64 result
        {
            tunnel std::math::cos(radians - 1.5707963267948966) -> f64 result;
        }
    }

    namespace time
    {
        struct TimePoint
        {
            i64 seconds;
            i64 nanoseconds;
        }

        def now() -> std::time::TimePoint result
        {
            reserve std::time::TimePoint value;
            __sys_gettime_parts(&value.seconds, &value.nanoseconds);
            tunnel value -> std::time::TimePoint result;
        }

        def unix_seconds() -> i64 result
        {
            reserve std::time::TimePoint value = std::time::now();
            tunnel value.seconds -> i64 result;
        }

        // Blocks the current program for at least the requested number of milliseconds.
        def sleep(u64 milliseconds)
        {
            __sys_sleep_ms(milliseconds);
        }
    }

    namespace io
    {
        def write(i32 descriptor, std::string::view::View content) -> i64 result
        {
            tunnel __sys_write(descriptor, content.data, content.length) -> i64 result;
        }

        def print(std::string::view::View content) -> i64 result
        {
            tunnel std::io::write(1, content) -> i64 result;
        }

        def println(std::string::view::View content) -> i64 result
        {
            reserve i64 ignored = std::io::write(1, content);
            tunnel __sys_write(1, "\n", 1) -> i64 result;
        }

        def eprint(std::string::view::View content) -> i64 result
        {
            tunnel std::io::write(2, content) -> i64 result;
        }

        def eprintln(std::string::view::View content) -> i64 result
        {
            reserve i64 ignored = std::io::write(2, content);
            tunnel __sys_write(2, "\n", 1) -> i64 result;
        }

    }

    def __print(std::string::view::View content) -> i64 result
    {
        tunnel std::io::print(content) -> i64 result;
    }

    def __println(std::string::view::View content) -> i64 result
    {
        tunnel std::io::println(content) -> i64 result;
    }

    cdec __sys_write(i64 fd, *i8 buffer, u64 count) -> i64;
    cdec __shaft_alloc(u64 count) -> *u8;
    cdec __shaft_alloc_or_exit(u64 count) -> *u8;
    cdec __shaft_free(*u8 pointer);
    cdec __sys_int_to_string(i64 value, *u8 buffer, u64 capacity) -> u64;
    cdec __sys_uint_to_string(u64 value, *u8 buffer, u64 capacity) -> u64;
    cdec __sys_float_to_string(f64 value, *u8 buffer, u64 capacity) -> u64;
    cdec __sys_exit(i32 status);

    // Compiler-lowered native Thread support. These are runtime ABI hooks, not public APIs.
    cdec __shaft_thread_create(*u8 stack, *u8 entry, *u8 context, *u64 handle) -> i32;
    cdec __sys_thread_join(*u64 handle) -> i32;
    cdec __shaft_runtime_lock();
    cdec __shaft_runtime_unlock();
    cdec exit(i32 status);
    cdec __sys_gettime_parts(*i64 seconds, *i64 nanoseconds) -> i32;
    cdec __sys_sleep_ms(u64 milliseconds) -> i32;
    cdec __sys_restore_terminal();
    cdec __cstr_strlen(*i8 text) -> u64;
    mut u64 __shaft_main_argc;
    cdec __main(std::string::String[] args);

    cdef __shaft_entry(i32 argc, **i8 argv) -> i32
    {
        __shaft_main_argc = argc as u64;
        mut std::string::String[] args = __shaft_alloc_or_exit(argc * 24);
        mut u64 argumentIndex = 0;
        while (argumentIndex < argc)
        {
            *i8 text = argv[argumentIndex];
            u64 length = __cstr_strlen(text);
            args[argumentIndex].data = __shaft_alloc_or_exit(length + 1);
            args[argumentIndex].length = length;
            args[argumentIndex].capacity = length;
            std::memory::memcpy(args[argumentIndex].data, text, length);
            argumentIndex = argumentIndex + 1;
        }
        __main(args);
        __sys_restore_terminal();
        return 0;
    }

    cdec __sys_open(*i8 pathname, i32 mode) -> i64;
    cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;
    cdec __sys_readline(*u8 buffer, u64 capacity) -> i64;
    cdec __sys_close(i64 descriptor) -> i64;
    cdec __sys_file_size(i64 descriptor) -> i64;

    namespace io
    {
        def readline() -> std::string::String result
        {
            reserve mut std::string::String line = std::string::String::with_capacity(65536);
            reserve i64 length = __sys_readline(line.data, line.capacity);
            if (length < 0)
            {
                line.length = 0;
            }
            else
            {
                line.length = length as u64;
            }
            line.data[line.length] = 0;
            tunnel line -> std::string::String result;
        }

        cdec __sys_read(i64 descriptor, *i8 buffer, u64 count) -> i64;

        def read_bytes(u64 requested) -> std::string::String result
        {
            mut *i8 buffer = __shaft_alloc_or_exit(requested);

            mut u64 total = 0;

            while (total < requested)
            {
                i64 n = __sys_read(
                0,
                buffer + total,
                requested - total
                );

                if (n <= 0)
                {
                    break;
                }

                total = total + n;
            }

            mut std::string::view::View slice;
            slice.length = total;
            slice.data = buffer;
            slice.data[slice.length] = 0;
            reserve std::string::String s = std::string::String::from_view(slice);

            tunnel s -> std::string::String result;
        }
    }

    namespace filesystem
    {
        struct File{
            i64 descriptor;
        }

        def read_into(std::string::view::View pathname, *u8 buffer, u64 capacity) -> i64 result
        {
            mut i64 received = 0;
            reserve i64 descriptor = __sys_open(pathname.data, 0);
            if (descriptor >= 0)
            {
                while (received < capacity)
                {
                    reserve i64 count = __sys_read(descriptor, &buffer[received], capacity - received);
                    if (count <= 0)
                    {
                        break;
                    }
                    received = received + count;
                }
                __sys_close(descriptor);
            }
            tunnel received -> i64 result;
        }

        def read(std::string::view::View pathname) -> std::string::String result
        {
            reserve mut std::string::String content;
            reserve i64 descriptor = __sys_open(pathname.data, 0);
            if (descriptor >= 0)
            {
                reserve i64 size = __sys_file_size(descriptor);
                if (size >= 0)
                {
                    content = std::string::String::with_capacity(size);
                    mut u64 received = 0;
                    while (received < size)
                    {
                        reserve i64 count = __sys_read(descriptor, &content.data[received], size - received);
                        if (count <= 0)
                        {
                            break;
                        }
                        received = received + count;
                    }
                    content.length = received;
                    content.data[received] = 0;
                }
                __sys_close(descriptor);
            }
            tunnel content -> std::string::String result;
        }

        def write_at_mode(std::string::view::View pathname, std::string::view::View content, i32 openMode) -> i64 result
        {
            mut i64 total = 0;
            reserve i64 descriptor = __sys_open(pathname.data, openMode);
            if (descriptor >= 0)
            {
                while (total < content.length)
                {
                    reserve i64 count = __sys_write(descriptor, &content.data[total], content.length - total);
                    if (count <= 0)
                    {
                        break;
                    }
                    total = total + count;
                }
                __sys_close(descriptor);
            }
            tunnel total -> i64 result;
        }

        def write(std::string::view::View pathname, std::string::view::View content) -> i64 result
        {
            tunnel std::filesystem::write_at_mode(pathname, content, 1) -> i64 result;
        }

        def append(std::string::view::View pathname, std::string::view::View content) -> i64 result
        {
            tunnel std::filesystem::write_at_mode(pathname, content, 3) -> i64 result;
        }
    }

