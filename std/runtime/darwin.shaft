cdef __sys_sleep_ms(u64 milliseconds) -> i32
{
    mut RuntimeTimeSpec duration;
    mut RuntimeTimeSpec remaining;
    duration.seconds = (milliseconds / (1000 as u64)) as i64;
    duration.nanoseconds = ((milliseconds % (1000 as u64)) * (1000000 as u64)) as i64;
    while (true)
    {
