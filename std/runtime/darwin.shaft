cdef __runtime_key_from_byte(i32 byte) -> i32
{
    if (byte == 10 || byte == 13) { return 13; }
    if (byte >= 1 && byte <= 26) { return byte + 16448; }
    if (byte >= 97 && byte <= 122) { return byte - 32; }
    if (byte == 127) { return 8; }
