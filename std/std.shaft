        cdec __sys_read_key() -> i32;
        cdec __sys_execv(*i8 command, **i8 arguments) -> i64;
        cdec __sys_process_spawn(*i8 command, **i8 arguments, i64 stdoutDescriptor, i64 stderrDescriptor) -> i64;
        cdec __sys_process_wait(i64 pid) -> i64;
        cdec __sys_process_pipe(*i64 descriptors) -> i64;
        cdec __sys_process_set_nonblocking(i64 descriptor) -> i64;
        cdec __sys_process_read(i64 descriptor, *i8 buffer, u64 count) -> i64;
        cdec __sys_process_null() -> *i8;

        struct Child{
            mut i64 pid;

        }

        impl Child
        {
            def wait(&mut self) -> i32 result
            {
                mut i64 rawStatus = -1;
                if (self.pid >= 0)
                {
                    rawStatus = __sys_process_wait(self.pid);
                    self.pid = -1;
                }
                if (rawStatus < 0)
                {
                    tunnel -1 as i32 -> i32 result;
                }
                else
                {
                    tunnel ((rawStatus >> 8) & 255) as i32 -> i32 result;
                }
            }
        }

        struct Output
        {
            mut i32 status;
            mut std::string::String stdout;
            mut std::string::String stderr;
        }

        struct Command
        {
            mut std::string::String program;
            mut std::vector::Vector<std::string::String> arguments;
        }

        impl Command
        {
            def new(std::string::view::View program) -> std::process::Command result
            {
                reserve mut std::process::Command command;
                command.program = std::string::String::from_view(program);
                std::vector::init::<std::string::String>(ref command.arguments, 4);
                tunnel command -> std::process::Command result;
            }

            def arg(&mut self, std::string::view::View value) -> bool result
            {
                reserve std::string::String argument = std::string::String::from_view(value);
                tunnel self.arguments.push(argument) -> bool result;
            }

            def spawn_with_redirects(&self, i64 stdoutDescriptor, i64 stderrDescriptor) -> i64 result
            {
                mut u64 count = self.arguments.length + 2;
                mut **i8 arguments = __shaft_alloc_or_exit(count * 8);
                arguments[0] = self.program.data;
                mut *std::string::String argumentData = self.arguments.data;
                mut u64 argumentIndex = 0;
                while (argumentIndex < self.arguments.length)
                {
                    arguments[argumentIndex + 1] = argumentData[argumentIndex].data;
                    argumentIndex = argumentIndex + 1;
                }
                arguments[count - 1] = __sys_process_null();
                tunnel __sys_process_spawn(self.program.data, arguments, stdoutDescriptor, stderrDescriptor) -> i64 result;
            }

            def spawn(&self) -> std::process::Child result
            {
                reserve mut std::process::Child child;
                child.pid = self.spawn_with_redirects(-1, -1);
                tunnel child -> std::process::Child result;
            }

            def status(&self) -> i32 result
            {
                reserve mut std::process::Child child = self.spawn();
                tunnel child.wait() -> i32 result;
            }

            def output(&self) -> std::process::Output result
            {
                reserve mut std::process::Output output;
                output.status = -1;
                output.stdout = std::string::String::with_capacity(256);
                output.stderr = std::string::String::with_capacity(256);
                mut i64[2] stdoutPipe;
                mut i64[2] stderrPipe;
                if (__sys_process_pipe(&stdoutPipe[0]) == 0)
                {
                    if (__sys_process_pipe(&stderrPipe[0]) == 0)
                    {
                        reserve i64 child = self.spawn_with_redirects(stdoutPipe[1], stderrPipe[1]);
                        __sys_close(stdoutPipe[1]);
                        __sys_close(stderrPipe[1]);
                        if (child >= 0)
                        {
                            __sys_process_set_nonblocking(stdoutPipe[0]);
                            __sys_process_set_nonblocking(stderrPipe[0]);
                            mut bool stdoutOpen = true;
                            mut bool stderrOpen = true;
                            mut u8[256] buffer;
                            while (stdoutOpen || stderrOpen)
                            {
                                if (stdoutOpen)
                                {
                                    reserve i64 received = __sys_process_read(stdoutPipe[0], &buffer[0], 256);
                                    if (received > 0)
                                    {
                                        mut std::string::view::View chunk;
                                        chunk.data = &buffer[0];
                                        chunk.length = received as u64;
                                        output.stdout.append(chunk);
                                    }
                                    else if (received == 0)
                                    {
                                        __sys_close(stdoutPipe[0]);
                                        stdoutOpen = false;
                                    }
                                }
                                if (stderrOpen)
                                {
                                    reserve i64 received = __sys_process_read(stderrPipe[0], &buffer[0], 256);
                                    if (received > 0)
                                    {
                                        mut std::string::view::View chunk;
                                        chunk.data = &buffer[0];
                                        chunk.length = received as u64;
                                        output.stderr.append(chunk);
                                    }
                                    else if (received == 0)
                                    {
                                        __sys_close(stderrPipe[0]);
                                        stderrOpen = false;
                                    }
                                }
                            }
                            reserve mut std::process::Child waited;
                            waited.pid = child;
                            output.status = waited.wait();
                        }
                        else
                        {
                            __sys_close(stdoutPipe[0]);
                            __sys_close(stderrPipe[0]);
                        }
                    }
                    else
                    {
                        __sys_close(stdoutPipe[0]);
                        __sys_close(stdoutPipe[1]);
                    }
                }
                tunnel output -> std::process::Output result;
            }

        }

    }

    namespace network
    {
        struct SockaddrIn
        {
            mut u16 family;
            mut u16 port;
            mut u32 address;
            mut u8[8] zero;
        }

        struct Socket
        {
            mut i64 descriptor;
        }

        cdec __sys_socket(i32 domain, i32 type, i32 protocol) -> i64;
        cdec __sys_connect(i64 descriptor, *u8 address, u32 addressLength) -> i64;
        cdec __sys_bind(i64 descriptor, *u8 address, u32 addressLength) -> i64;
        cdec __sys_listen(i64 descriptor, i32 backlog) -> i64;
        cdec __sys_accept(i64 descriptor, *u8 address, *u32 addressLength) -> i64;
        cdec __sys_send(i64 descriptor, *u8 buffer, u64 length, i32 flags) -> i64;
        cdec __sys_recv(i64 descriptor, *u8 buffer, u64 length, i32 flags) -> i64;
        cdec __sys_sendto(i64 descriptor, *u8 buffer, u64 length, i32 flags, *u8 destination, u32 destinationLength) -> i64;
        cdec __sys_recvfrom(i64 descriptor, *u8 buffer, u64 length, i32 flags, *u8 source, *u32 sourceLength) -> i64;
        cdec __sys_shutdown(i64 descriptor, i32 how) -> i64;
        cdec __sys_socket_close(i64 descriptor) -> i64;
        cdec __sys_tcp_socket() -> i64;
        cdec __sys_udp_socket() -> i64;
        cdec __sys_tcp_connect_ipv4(i64 descriptor, u32 address, u16 port) -> i64;
        cdec __sys_tcp_listen_ipv4(u32 address, u16 port, i32 backlog) -> i64;
        cdec __sys_socket_accept(i64 descriptor) -> i64;
        cdec __sys_socket_set_nonblocking(i64 descriptor) -> i64;
        cdec __sys_socket_try_accept(i64 descriptor) -> i64;
        cdec __sys_socket_try_send(i64 descriptor, *u8 buffer, u64 length) -> i64;
        cdec __sys_socket_try_recv(i64 descriptor, *u8 buffer, u64 length) -> i64;

        def ipv4(u32 first, u32 second, u32 third, u32 fourth) -> u32 result
        {
            tunnel ((first << 24) | (second << 16) | (third << 8) | fourth) as u32 -> u32 result;
        }

        def tcp() -> std::network::Socket result
        {
            reserve mut std::network::Socket socket;
            socket.descriptor = __sys_tcp_socket();
            tunnel socket -> std::network::Socket result;
        }

        def udp() -> std::network::Socket result
        {
            reserve mut std::network::Socket socket;
            socket.descriptor = __sys_udp_socket();
            tunnel socket -> std::network::Socket result;
        }

        def tcp_connect_ipv4(u32 address, u16 port) -> std::network::Socket result
        {
            reserve mut std::network::Socket socket = std::network::tcp();
            if (socket.descriptor >= 0)
            {
                reserve i64 connected = __sys_tcp_connect_ipv4(socket.descriptor, address, port);
                if (connected != 0)
                {
                    __sys_socket_close(socket.descriptor);
                    socket.descriptor = -1;
                }
            }
            tunnel socket -> std::network::Socket result;
        }

        def tcp_listen_ipv4(u32 address, u16 port, i32 backlog) -> std::network::Socket result
        {
            reserve mut std::network::Socket socket;
            socket.descriptor = __sys_tcp_listen_ipv4(address, port, backlog);
            tunnel socket -> std::network::Socket result;
        }

        def accept(*std::network::Socket listener) -> std::network::Socket result
        {
            reserve mut std::network::Socket socket;
            socket.descriptor = __sys_socket_accept(listener.descriptor);
            tunnel socket -> std::network::Socket result;
        }

        def set_nonblocking(*std::network::Socket socket) -> i64 result
        {
            tunnel __sys_socket_set_nonblocking(socket.descriptor) -> i64 result;
        }

        def try_accept(*std::network::Socket listener) -> std::network::Socket result
        {
            reserve mut std::network::Socket socket;
            socket.descriptor = __sys_socket_try_accept(listener.descriptor);
            tunnel socket -> std::network::Socket result;
        }

        def try_send(*std::network::Socket socket, std::string::view::View content) -> i64 result
        {
            tunnel __sys_socket_try_send(socket.descriptor, content.data, content.length) -> i64 result;
        }

        def try_receive(*std::network::Socket socket, *u8 buffer, u64 capacity) -> i64 result
        {
            tunnel __sys_socket_try_recv(socket.descriptor, buffer, capacity) -> i64 result;
        }

        def send(*std::network::Socket socket, std::string::view::View content) -> i64 result
        {
            mut i64 total = 0;
            while (total < content.length)
            {
                reserve i64 written = __sys_send(
                socket.descriptor,
                &content.data[total],
                content.length - total,
                0
                );
                if (written <= 0)
                {
                    break;
                }
                total = total + written;
            }
            tunnel total -> i64 result;
        }

        def receive(*std::network::Socket socket, *u8 buffer, u64 capacity) -> i64 result
        {
            tunnel __sys_recv(socket.descriptor, buffer, capacity, 0) -> i64 result;
        }

        def shutdown(*std::network::Socket socket, i32 how) -> i64 result
        {
            tunnel __sys_shutdown(socket.descriptor, how) -> i64 result;
        }

        def close(*std::network::Socket socket) -> i64 result
        {
            mut i64 closed = 0;
            if (socket.descriptor >= 0)
            {
                closed = __sys_socket_close(socket.descriptor);
                socket.descriptor = -1;
            }
            tunnel closed -> i64 result;
        }

    }

    namespace dns
    {
        namespace __impl
        {
            def read_u16(*u8 data, u64 offset) -> u16 result
            {
                tunnel (
                (data[offset] as u16 << 8) |
                (data[offset + 1] as u16)
                ) as u16 -> u16 result;
            }

            def read_u32(*u8 data, u64 offset) -> u32 result
            {
                tunnel (
                (data[offset] as u32 << 24) |
                ((data[offset + 1] as u32) << 16) |
                ((data[offset + 2] as u32) << 8) |
                (data[offset + 3] as u32)
                ) as u32 -> u32 result;
            }

            def write_u16(*u8 data, u64 offset, u16 value)
            {
                data[offset] = (value >> 8) as u8;
                data[offset + 1] = value as u8;
            }

            def encode_name(*u8 packet, u64 offset, std::string::view::View hostname) -> u64 result
            {
                mut u64 packet_offset = offset;
                mut u64 label_start = 0;
                mut u64 i = 0;

                while (i <= hostname.length)
                {
                    if (i == hostname.length || hostname.data[i] == '.')
                    {
                        mut u64 label_length = i - label_start;

                        packet[packet_offset] = label_length as u8;
                        packet_offset = packet_offset + 1;

                        mut u64 j = 0;
                        while (j < label_length)
                        {
                            packet[packet_offset] =
                            hostname.data[label_start + j];

                            packet_offset = packet_offset + 1;
                            j = j + 1;
                        }

                        label_start = i + 1;
                    }

                    i = i + 1;
                }

                packet[packet_offset] = 0;
                packet_offset = packet_offset + 1;

                tunnel packet_offset -> u64 result;
            }

            def skip_name(*u8 packet, u64 offset, u64 packet_length) -> u64 result
            {
                mut u8 tunnel_type = 0;
                mut u64 current = offset;

                while (current < packet_length)
                {
                    mut u8 length = packet[current];

                    if ((length & 0xC0) == 0xC0)
                    {
                        break;
                    }

                    if (length == 0)
                    {
                        tunnel_type = 1;
                        break;
                    }

                    current = current + 1 + length;
                }

                match (tunnel_type)
                {
                    case 0
                    {
                        tunnel current + 2 -> u64 result;
                    }
                    case 1
                    {
                        tunnel current + 1 -> u64 result;
                    }
                    default
                    {
                        tunnel packet_length -> u64 result;
                    }
                }
            } // namespace __impl

            struct DNS
            {
                mut u16 next_transaction_id = 1;
                mut u32 dns_server = 0x08080808;
            }

            impl DNS
            {
                def resolve(&mut self, std::string::view::View hostname) -> u32 result, -> bool error
                {
                    mut u32 address = 0;
                    mut u8 tunnel_type = 0;
                    mut bool error = false;
                    reserve mut std::network::Socket socket = std::network::udp();

                    if (socket.descriptor < 0)
                    {
                        error = true;
                    }

                    mut u8[512] packet;

                    mut u16 transaction_id = self.next_transaction_id;
                    self.next_transaction_id = self.next_transaction_id + (1 as u16);

                    mut u64 offset = 0;

                    packet[offset] = (transaction_id >> 8) as u8;
                    packet[offset + 1] = transaction_id as u8;
                    offset = offset + 2;

                    packet[offset] = 0x01;
                    packet[offset + 1] = 0x00;
                    offset = offset + 2;

                    packet[offset] = 0;
                    packet[offset + 1] = 1;
                    offset = offset + 2;

                    packet[offset] = 0;
                    packet[offset + 1] = 0;
                    offset = offset + 2;

                    packet[offset] = 0;
                    packet[offset + 1] = 0;
                    offset = offset + 2;

                    packet[offset] = 0;
                    packet[offset + 1] = 0;
                    offset = offset + 2;

                    offset = std::dns::__impl::encode_name(&packet[0], offset, hostname);

                    packet[offset] = 0;
                    packet[offset + 1] = 1;
                    offset = offset + 2;

                    packet[offset] = 0;
                    packet[offset + 1] = 1;
                    offset = offset + 2;

                    reserve mut std::network::SockaddrIn destination;

                    destination.family = 2;
                    destination.port = 0x3500;
                    destination.address = self.dns_server;

                    mut i64 sent = __sys_sendto(
                    socket.descriptor,
                    &packet[0],
                    offset,
                    0,
                    &destination,
                    sizeof(std::network::SockaddrIn)
                    );

                    if (sent < 0)
                    {
                        std::network::close(&socket);
                        error = true;
                    }

                    mut u8[512] response;

                    mut std::network::SockaddrIn source;
                    mut u32 source_length = sizeof(std::network::SockaddrIn) as u32;

                    if (!error)
                    {
                        mut i64 received = __sys_recvfrom(
                        socket.descriptor,
                        &response[0],
                        512,
                        0,
                        &source,
                        &source_length
                        );

                        std::network::close(&socket);

                        if (received < 12)
                        {
                            error = true;
                        }

                        reserve mut u16 response_id =
                        std::dns::__impl::read_u16(&response[0], 0);

                        if (response_id != transaction_id)
                        {
                            error = true;
                        }

                        reserve mut u16 flags =
                        std::dns::__impl::read_u16(&response[0], 2);

                        if ((flags & 0x8000) == 0)
                        {
                            error = true;
                        }

                        if ((flags & 0x000F) != 0)
                        {
                            error = true;
                        }

                        reserve mut u16 question_count =
                        std::dns::__impl::read_u16(&response[0], 4);

                        reserve mut u16 answer_count =
                        std::dns::__impl::read_u16(&response[0], 6);

                        if (question_count != 1)
                        {
                            error = true;
                        }

                        mut u64 response_offset = 12;

                        response_offset = std::dns::__impl::skip_name(
                        &response[0],
                        response_offset,
                        received
                        );

                        response_offset = response_offset + 2;

                        response_offset = response_offset + 2;

                        mut u16 answer = 0;

                        while (answer < answer_count)
                        {
                            if (response_offset >= received)
                            {
                                error = true;
                            }

                            response_offset = std::dns::__impl::skip_name(
                            &response[0],
                            response_offset,
                            received
                            );

                            if (response_offset + 10 > received)
                            {
                                error = true;
                            }

                            reserve mut u16 record_type =
                            std::dns::__impl::read_u16(&response[0], response_offset);

                            response_offset = response_offset + 2;

                            reserve mut u16 record_class =
                            std::dns::__impl::read_u16(&response[0], response_offset);

                            response_offset = response_offset + 2;

                            reserve mut u32 ttl =
                            std::dns::__impl::read_u32(&response[0], response_offset);

                            response_offset = response_offset + 4;

                            reserve mut u16 data_length =
                            std::dns::__impl::read_u16(&response[0], response_offset);

                            response_offset = response_offset + 2;

                            if (response_offset + data_length > received)
                            {
                                error = true;
                            }

                            if (record_type == 1 &&
                            record_class == 1 &&
                            data_length == 4)
                            {
                                address = (
                                ((0 + response[response_offset]) << 24) |
                                ((0 + response[response_offset + 1]) << 16) |
                                ((0 + response[response_offset + 2]) << 8) |
                                (0 + response[response_offset + 3])
                                ) as u32;

                                tunnel_type = 1;
                            }

                            response_offset =
                            response_offset + data_length;

                            answer = answer + (1 as u16);
                        }
                    }

                    match (tunnel_type)
                    {
                        case 1
                        {
                            tunnel address -> u32 result;
                        }
                        default
                        {
                            tunnel 0 as u32 -> u32 result;
                        }
                    }
                    tunnel error -> bool error;
                }
            } // impl DNS
        } // namespace dns
    } // namespace network

    namespace random
    {
        struct RNG
        {
            mut u32 state;
        }

        impl RNG
        {
            def new() -> std::random::RNG rng
            {
                tunnel std::random::RNG {std::time::unix_seconds()} -> std::random::RNG rng;
            }

            def set_seed(&mut self, i32 seed)
            {
                self.state = seed as u32;
            }

            def skip(&mut self)
            {
                mut u32 x = self.state;
                x = (x ^ (x << 13)) as u32;
                x = (x ^ (x >> 17)) as u32;
                x = (x ^ (x << 5)) as u32;
                self.state = x;
            }

            def get_int(&mut self, i32 min, i32 max) -> i32 result
            {
                self.skip();
                u32 range = (max - min + 1) as u32;
                u32 limit = ((0xFFFFFFFF as u32) / range) * range;
                while (self.state >= limit)
                {
                    self.skip();
                }
                tunnel ((self.state % range) as i32) + min -> i32 result;
            }

            def get_u64(&mut self) -> u64 result
            {
                self.skip();
                u32 high = self.state;
                self.skip();
                u32 low = self.state;
                tunnel (((high as u64) << 32) | (low as u64)) -> u64 result;
            }

            def get_float(&mut self, f32 min, f32 max) -> f32 result
            {
                self.skip();
                f32 range = (max - min) as f32;
                f32 unit = ((self.state as f32) / (4294967296.0 as f32)) as f32;
                tunnel (unit * range + min) as f32 -> f32 result;
            }
        } //impl RNG

        namespace uuid
        {
            struct UUIDv4
            {
                u64 high;
                u64 low;
            }

            impl UUIDv4
            {
                def new() -> std::random::uuid::UUIDv4 uuid
                {
                    *u8 random_ptr = __shaft_alloc_or_exit(sizeof(u8));
                    std::random::RNG bootstrap_rng = {std::time::unix_seconds() ^ random_ptr + 5};
                    std::random::RNG rng = {bootstrap_rng.get_int(0, sizeof(u64))};
                    reserve mut u64 high = rng.get_u64();
                    reserve mut u64 low = rng.get_u64();

                    high = (high & 0xffffffffffff0fff) | 0x0000000000004000;
                    low = (low & 0x3fffffffffffffff) | 0x8000000000000000;

                    tunnel std::random::uuid::UUIDv4 {high, low} -> std::random::uuid::UUIDv4 uuid;
                }

                def equals(&mut self, std::random::uuid::UUIDv4 other) -> bool matches
                {
                    tunnel (self.low == other.low) && (self.high == other.high) -> bool matches;
                }
            }
        } // namespace uuid
    } // namespace random

    namespace thread
    {
        struct<T> Message
        {
            std::random::uuid::UUIDv4 sender_id;
            T data;
        }

        struct<T> Channel
        {
            mut std::vector::Vector<std::thread::Message<T>> buffer;
        }

        impl<T> Channel<T>
        {
            def send(&mut self, std::random::uuid::UUIDv4 id, T data)
            {
                __shaft_runtime_lock();
                std::thread::Message<T> msg = {id, data};
                self.buffer.push(msg);
                __shaft_runtime_unlock();
            }

            def check(&mut self, std::random::uuid::UUIDv4 id) -> bool matches
            {
                __shaft_runtime_lock();
                if (self.buffer.length == 0)
                {
                    tunnel false -> bool matches;
                }
                else
                {
                    tunnel (self.buffer[self.buffer.length - 1].sender_id.equals(id)) -> bool matches;
                }
                __shaft_runtime_unlock();
            }

            def receive(&mut self) -> std::error::Result<std::thread::Message<T>> msg
            {
                __shaft_runtime_lock();
                mut std::error::Result<std::thread::Message<T>> result;
                mut bool is_empty = self.buffer.length == 0;
                if (is_empty)
                {
                    std::error::Result<std::thread::Message<T>> error = std::error::Result::Error(std::string::String::from_str("Buffer is empty!"));
                    result = move error;
                }
                else
                {
                    std::thread::Message<T> received = self.buffer.data[0];
                    self.buffer.data = self.buffer.data + 1;
                    self.buffer.length = self.buffer.length - 1;
                    self.buffer.capacity = self.buffer.capacity - 1;
                    std::error::Result<std::thread::Message<T>> message = std::error::Result::Value(received);
                    result = move message;
                }
                tunnel result -> std::error::Result<std::thread::Message<T>> msg;
                __shaft_runtime_unlock();
            }
        } // impl<T> Channel<T> rr

        def lock()
        {
            __shaft_runtime_lock();
        }

        def unlock()
        {
            __shaft_runtime_unlock();
        }
    } //namespace thread
} // namespace std

@using global str!($str:value) -> std::string::String::from_str($value);
@using global print!(content) -> std::io::print($content);
@using global type_of!($expr:value) -> typeof($value);
@using global to_string!($str:value) -> std::string::String::from_str($value);
@using global to_string!($expr:value) ->
@comptime iftype($value, char) { std::string::String::from_char($value) } else {
    @comptime iftype($value, i8) { std::string::String::from_i8($value) } else {
        @comptime iftype($value, u8) { std::string::String::from_u8($value) } else {
            @comptime iftype($value, i16) { std::string::String::from_i16($value) } else {
                @comptime iftype($value, u16) { std::string::String::from_u16($value) } else {
                    @comptime iftype($value, i32) { std::string::String::from_i32($value) } else {
                        @comptime iftype($value, u32) { std::string::String::from_u32($value) } else {
                            @comptime iftype($value, i64) { std::string::String::from_i64($value) } else {
                                @comptime iftype($value, u64) { std::string::String::from_u64($value) } else {
                                    @comptime iftype($value, usize) { std::string::String::from_usize($value) } else {
                                        @comptime iftype($value, f32) { std::string::String::from_f32($value) } else {
                                            @comptime iftype($value, f64) { std::string::String::from_f64($value) } else {
                                                @comptime iftype($value, bool) { std::string::String::from_bool($value) } else {
                                                    @comptime iftype($value, std::string::view::View) { std::string::String::from_view($value) } else {
                                                        @comptime iftype($value, *u8) { std::string::String::from_str($value) } else {
                                                            @comptime iftype($value, std::string::String) { $value } else {
                                                                __shaft_unsupported_to_string($value)
                                                            } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end } @end;
@using global format!($str:text) -> std::string::String::from_str($text);
@using global println!($str:text) -> std::io::println($text);
@using global println!($str:template, $tt:values...) -> {
    @unsafe
    reserve std::string::String print_output = std::string::String::from_str("");
    format_many_into!(print_output, $template, $values)
    std::io::println(print_output.get_view());
    @end
};
@using global format!($tt:values...) -> __shaft_format($values);

@using global format_values_push!($ident:values) -> {};
@using global format_values_push!($ident:values, $expr:value) -> {
    reserve std::string::String format_value = to_string!($value);
    std::vector::push::<std::string::String>(ref $values, format_value);
};
@using global format_values_push!($ident:values, $expr:value, $tt:tail...) -> {
    @unsafe
    reserve std::string::String format_value = to_string!($value);
    std::vector::push::<std::string::String>(ref $values, format_value);
    format_values_push!($values, $tail)
    @end
};
@using global format_many_into!($ident:output, $str:template, $tt:values...) -> {
    @unsafe
    reserve mut std::vector::Vector<std::string::String> format_values;
    std::vector::init::<std::string::String>(ref format_values, 0);
    format_values_push!(format_values, $values)
    reserve mut std::vector::Vector<std::string::view::View> format_views;
    std::vector::init::<std::string::view::View>(ref format_views, format_values.length);
    mut u64 format_index = 0;
    while (format_index < format_values.length)
    {
        std::vector::push::<std::string::view::View>(ref format_views, format_values[format_index].get_view());
        format_index = format_index + 1;
    }
    reserve ?std::string::String format_rendered = std::string::format::render_many($template, format_views.data, format_views.length);
    valid format_rendered
    {
        $output.append(format_rendered.get_view());
    }
    @end
};

@using global format_into!($ident:output) -> {};
@using global format_into!($ident:output, $expr:value) -> {
    reserve std::string::String format_part = to_string!($value);
    $output.append(format_part.get_view());
};
@using global format_into!($ident:output, $expr:value, $tt:tail...) -> {
    reserve std::string::String format_part = to_string!($value);
    $output.append(format_part.get_view());
    format_into!($output, $tail)
};
@using global panic!($str:message) ->
{
    @unsafe
    std::io::println($message);
    std::exit(101);
    @end
};
@using global panic!() ->
{
    @unsafe
    std::io::println("Exit code 101: Explicit panic call");
    std::exit(101);
    @end
};

@using global exit!($expr:status) ->
{
    @unsafe
    std::exit($status);
    @end
};
