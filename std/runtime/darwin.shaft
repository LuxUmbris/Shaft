}

cdef __runtime_key_from_final(i32 final) -> i32
{
    if (final == 65) { return 257; }
    if (final == 66) { return 258; }
    if (final == 67) { return 259; }
    if (final == 68) { return 260; }
    if (final == 72) { return 261; }
    if (final == 70) { return 262; }
    if (final == 80) { return 272; }
    if (final == 81) { return 273; }
    if (final == 82) { return 274; }
    if (final == 83) { return 275; }
