{
  "Shaft entry point": {
    "prefix": "shaft-entry",
    "description": "Freestanding Shaft program entry point",
    "body": [
      "cdef __shaft_entry(i32 argc, *i8 argv) -> i32",
      "{",
      "    ${1:return 0;}",
      "}"
    ]
  },
  "Shaft function with tunnel": {
    "prefix": "shaft-def",
    "description": "Shaft function with a required tunnel result",
    "body": [
      "def ${1:name}(${2}) -> ${3:u64} result",
      "{",
      "    tunnel ${4:value} -> ${3:u64} result;",
      "}"
    ]
  },
  "Shaft namespace": {
    "prefix": "shaft-namespace",
    "description": "Shaft namespace declaration",
    "body": ["namespace ${1:Name}", "{", "    ${0}", "}"]
  },
  "Shaft trait": {
    "prefix": "shaft-trait",
    "description": "Shaft trait declaration",
    "body": ["trait${1:<T>} ${2:Name}", "{", "    ${0}", "}"]
  },
  "Shaft struct": {
    "prefix": "shaft-struct",
    "description": "Shaft struct declaration",
    "body": ["struct${1:<T>} ${2:Name}", "{", "    ${0}", "}"]
  },
  "Shaft Vector": {
    "prefix": "shaft-vector",
    "description": "Initialize a std::vector::Vector<T>",
    "body": [
      "std::vector::Vector<${1:T}> ${2:values};",
      "std::vector::init(&${2:values}, ${3:8});",
      "${0}"
    ]
  }
}
