struct RuntimeAllocation{
    mut u64 offset;
    mut u64 size;
    mut bool free;
}

struct HeapChunk{
    mut *u8 memory_pool;
    mut u64 length;
    mut u64 capacity;
    mut u64 aligned_size;
    mut RuntimeAllocation[1024] runtime_allocations;
    mut u64 allocation_count;
    mut u64 next_address;
}

